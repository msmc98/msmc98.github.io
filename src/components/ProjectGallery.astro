---
import Icon from './Icon.astro';
import { galleryProjects } from '../content/project-gallery';
import rawCaptures from '../data/project-captures.json';
import ProjectMockup from './ProjectMockup.astro';
interface Capture { src: string; width: number; height: number; }
interface SiteCapture { desktop?: Capture | null; mobile?: Capture | null; title?: string; }
const captures = rawCaptures as Record<string, SiteCapture>;
interface Props { labels: { eyebrow: string; title: string; description: string; visit: string }; lang?: 'es' | 'en'; }
const { labels, lang = 'en' } = Astro.props;
const es = lang === 'es';
const categories = [
  { id: 'all', label: es ? 'Todos' : 'All' }, { id: 'tourism', label: es ? 'Turismo' : 'Tourism' },
  { id: 'corporate', label: es ? 'Corporativas' : 'Corporate' }, { id: 'commerce', label: es ? 'Comercio electrónico' : 'E-commerce' },
  { id: 'apps', label: es ? 'Aplicaciones web' : 'Web apps' },
];
const categoryNames: Record<string, string> = { tourism: es ? 'Turismo y experiencias' : 'Tourism & experiences', corporate: es ? 'Web corporativa' : 'Corporate website', commerce: es ? 'Comercio electrónico' : 'E-commerce', apps: es ? 'Desarrollo a medida' : 'Custom development' };
const websiteCount = galleryProjects.reduce((total, project) => total + project.sites.length, 0);
---
<project-gallery data-lang={lang}>
  <section class="projects-section" id="projects">
    <header class="projects-header">
      <h2>{labels.title}</h2>
      <div class="header-bottom"><div class="archive-stats"><strong>{websiteCount}</strong><span>{es ? 'WEBS EN MI RECORRIDO' : 'WEBS ALONG MY JOURNEY'}</span></div></div>
    </header>
    <div class="archive-controls">
      <div class="filters" role="group" aria-label={es ? 'Filtrar proyectos por sector' : 'Filter projects by sector'}>{categories.map((category) => <button type="button" data-filter={category.id} aria-pressed={category.id === 'all'}>{category.label}</button>)}</div>
      <p class="result-count" role="status" aria-live="polite"><span data-count>{galleryProjects.length}</span> {es ? 'proyectos' : 'projects'}</p>
    </div>
    <div class="projects-grid">
      {galleryProjects.map((project, index) => {
        const sites = project.sites.map((site) => ({ ...site, detail: site.description?.[lang], highlights: site.highlights?.[lang], desktop: captures[site.slug]?.desktop || null, mobile: captures[site.slug]?.mobile || null }));
        const first = sites[0];
        const projectName = project.featured && !es ? 'Four cities. One journey' : project.name;
        return <article class:list={['project', 'glass-panel', { 'project-featured': project.featured }]} data-category={project.category} data-sites={JSON.stringify(sites)} data-reveal style={`--project-accent:${project.accent}`}>
          <div class="project-visual"><ProjectMockup name={first.name} domain={new URL(first.url).hostname} desktop={first.desktop} mobile={first.mobile} lang={lang} /></div>
          <div class="project-content">
            <div class="project-meta"><span>{categoryNames[project.category]}</span><span class="project-index" aria-hidden="true"><Icon name={project.category === 'tourism' ? 'map' : project.category === 'corporate' ? 'building' : project.category === 'commerce' ? 'shop' : 'code'} /></span></div>
            <h3>{projectName.replace(/\.$/, '')}</h3><p class="description">{project.description[lang]}</p>
            {sites.length > 1 && <><div class="site-selector" role="group" aria-label={es ? 'Seleccionar web del conjunto' : 'Select a website from the collection'}>{sites.map((site, siteIndex) => <button type="button" data-site={siteIndex} aria-pressed={siteIndex === 0}>{site.name}</button>)}</div><noscript><ul>{sites.map((site) => <li><strong>{site.name}</strong><p>{site.detail}</p><a href={site.url} target="_blank" rel="noopener noreferrer">{site.name} ↗</a></li>)}</ul></noscript></>}
            {sites.length > 1 && <div class="site-detail" aria-live="polite"><h4 data-site-name>{first.name}</h4><p data-site-detail>{first.detail}</p><ul data-site-highlights>{first.highlights?.map(highlight => <li>{highlight}</li>)}</ul></div>}
            <div class="project-bottom"><span class="project-domain">{new URL(first.url).hostname}</span><a class="project-visit" href={first.url} target="_blank" rel="noopener noreferrer" aria-label={`${labels.visit}: ${first.name}`}>{labels.visit}<span aria-hidden="true">↗</span></a></div>
          </div>
        </article>;
      })}
    </div>
    <div class="archive-footer"><span>{es ? 'FIN DEL ARCHIVO / SIGUE EXPLORANDO' : 'END OF ARCHIVE / CONTINUE EXPLORING'}</span><a href="#contact">{es ? '¿Tu próximo proyecto?' : 'Your next project?'} ↗</a></div>
  </section>
  <dialog class="preview-dialog glass-panel" aria-labelledby="preview-title">
    <div class="preview-heading"><h3 id="preview-title"></h3><button type="button" data-close>{es ? 'Cerrar' : 'Close'} ×</button></div>
    <div class="preview-scroll"><img class="preview-image" alt="" /></div>
  </dialog>
</project-gallery>
<script>
  interface Screenshot { src: string; width: number; height: number; }
  interface Site { name: string; url: string; desktop: Screenshot | null; mobile: Screenshot | null; detail?: string; highlights?: string[]; }
  class ProjectGallery extends HTMLElement {
    private observer?: IntersectionObserver;
    connectedCallback() {
      const cards = Array.from(this.querySelectorAll<HTMLElement>('.project'));
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      if (!reduced.matches && 'IntersectionObserver' in window) {
        this.observer = new IntersectionObserver((entries) => {
          for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add('is-visible'); this.observer?.unobserve(entry.target); }
        }, { threshold: 0.08, rootMargin: '0px 0px -25px 0px' });
        this.classList.add('motion-enabled');
        cards.forEach((card) => this.observer?.observe(card));
        reduced.addEventListener('change', () => { if (reduced.matches) { this.classList.remove('motion-enabled'); this.observer?.disconnect(); } });
      }
      this.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((button) => {
        button.onclick = () => {
          this.querySelectorAll('[data-filter]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          let count = 0;
          for (const card of cards) { card.hidden = button.dataset.filter !== 'all' && card.dataset.category !== button.dataset.filter; if (!card.hidden) count++; }
          const counter = this.querySelector('[data-count]');
          if (counter) counter.textContent = String(count);
        };
      });
      for (const card of cards) {
        const sites: Site[] = JSON.parse(card.dataset.sites || '[]');
        card.dataset.selectedSite = '0';
        card.querySelectorAll<HTMLButtonElement>('[data-site]').forEach((button) => {
          button.onclick = () => {
            const site = sites[Number(button.dataset.site)];
            if (!site) return;
            card.dataset.selectedSite = button.dataset.site;
            card.querySelectorAll('[data-site]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
            for (const mode of ['desktop', 'mobile'] as const) {
              const image = card.querySelector<HTMLImageElement>(`[data-device="${mode}"]`);
              const screen = card.querySelector<HTMLButtonElement>(`[data-preview="${mode}"]`);
              const capture = site[mode];
              if (image) {
                image.hidden = !capture;
                if (capture) { image.src = capture.src; image.width = capture.width; image.height = capture.height; }
                else image.removeAttribute('src');
                image.alt = `${site.name} — ${this.dataset.lang === 'es' ? (mode === 'mobile' ? 'móvil' : 'escritorio') : mode}`;
              }
              if (screen) {
                screen.disabled = !capture;
                screen.setAttribute('aria-label', `${this.dataset.lang === 'es' ? 'Ampliar' : 'Enlarge'} ${site.name} — ${this.dataset.lang === 'es' ? (mode === 'mobile' ? 'móvil' : 'escritorio') : mode}`);
                const empty = screen.querySelector<HTMLElement>('.unavailable');
                const zoom = screen.querySelector<HTMLElement>('.zoom-label');
                if (empty) empty.hidden = !!capture;
                if (zoom) zoom.hidden = !capture;
              }
            }
            const name = card.querySelector('[data-site-name]'); if (name) name.textContent = site.name;
            const detail = card.querySelector('[data-site-detail]'); if (detail) detail.textContent = site.detail || '';
            const highlights = card.querySelector('[data-site-highlights]'); if (highlights) { highlights.replaceChildren(...(site.highlights || []).map(text => { const li=document.createElement('li'); li.textContent=text; return li; })); }
            card.querySelectorAll('.project-domain, .browser-domain').forEach((element) => { element.textContent = new URL(site.url).hostname; });
            const visit = card.querySelector<HTMLAnchorElement>('.project-visit');
            if (visit) { visit.href = site.url; visit.setAttribute('aria-label', `${this.dataset.lang === 'es' ? 'Ver proyecto' : 'Visit project'}: ${site.name}`); }
          };
        });
        card.querySelectorAll<HTMLButtonElement>('[data-preview]').forEach((button) => {
          button.onclick = () => {
            const site = sites[Number(card.dataset.selectedSite)];
            const mode = button.dataset.preview as 'desktop' | 'mobile';
            const shot = site?.[mode];
            const dialog = this.querySelector('dialog');
            const image = dialog?.querySelector<HTMLImageElement>('.preview-image');
            const title = dialog?.querySelector('#preview-title');
            if (!shot || !dialog || !image || !title) return;
            image.src = shot.src; image.width = shot.width; image.height = shot.height; image.alt = `${site.name} — ${this.dataset.lang === 'es' ? (mode === 'mobile' ? 'móvil' : 'escritorio') : mode}`;
            title.textContent = `${site.name} / ${mode === 'mobile' ? (this.dataset.lang === 'es' ? 'Móvil' : 'Mobile') : (this.dataset.lang === 'es' ? 'Escritorio' : 'Desktop')}`;
            dialog.dataset.mode = mode;
            dialog.showModal();
            document.dispatchEvent(new CustomEvent('portfolio:quest', { detail: 'preview' }));
            const scroll = dialog.querySelector('.preview-scroll');
            if (scroll) scroll.scrollTop = 0;
          };
        });
        if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
          const visual = card.querySelector<HTMLElement>('.project-visual');
          if (visual) {
            visual.onpointermove = (event) => {
              if (reduced.matches) return;
              const box = visual.getBoundingClientRect();
              const x = (event.clientX - box.left) / box.width - .5;
              const y = (event.clientY - box.top) / box.height - .5;
              visual.style.setProperty('--tilt-x', `${-y * 7}deg`); visual.style.setProperty('--tilt-y', `${x * 9}deg`);
              visual.style.setProperty('--phone-y', '-8px');
            };
            visual.onpointerleave = () => { visual.style.setProperty('--tilt-x', '0deg'); visual.style.setProperty('--tilt-y', '0deg'); visual.style.setProperty('--phone-y', '0px'); };
          }
        }
      }
      const dialog = this.querySelector('dialog');
      const close = this.querySelector<HTMLButtonElement>('[data-close]');
      if (dialog && close) { close.onclick = () => dialog.close(); dialog.onclick = (event) => { if (event.target === dialog) dialog.close(); }; }
    }
    disconnectedCallback() { this.observer?.disconnect(); }
  }
  if (!customElements.get('project-gallery')) customElements.define('project-gallery', ProjectGallery);
</script>
<style>
  project-gallery { display: block; }
  .projects-section { padding: clamp(80px, 9vw, 130px) clamp(22px, 5vw, 80px); border-top: 1px solid var(--border); background: var(--background); }
  .eyebrow { display: flex; align-items: center; gap: 10px; margin: 0 0 28px; font: 10px var(--mono-font); text-transform: uppercase; letter-spacing: .14em; color: var(--blue-light); }
  .eyebrow > span { width: 5px; height: 5px; background: var(--blue-light); border-radius: 50%; box-shadow: 0 0 12px #568bdb55; }
  h2 { margin: 0; font: 500 clamp(46px, 5.5vw, 82px)/1.05 var(--title-font); letter-spacing: -.045em; }
  h2 > span { display: block; margin-top: 10px; color: var(--text-muted); font-size: .55em; letter-spacing: -.025em; }
  .header-bottom { display: flex; justify-content: space-between; align-items: end; gap: 30px; margin-top: 28px; }
  .header-bottom > p { max-width: 560px; margin: 0; color: var(--text-muted); font-size: 13px; line-height: 1.9; }
  .archive-stats { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
  .archive-stats strong { font: 500 43px var(--title-font); color: var(--text); }
  .archive-stats span { max-width: 90px; font: 8px/1.8 var(--mono-font); letter-spacing: .12em; color: var(--text-muted); }
  .archive-controls { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; margin: 44px 0 28px; padding-top: 22px; border-top: 1px solid var(--border); }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; }
  .filters button { padding: 10px 15px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); font-size: 11px; cursor: pointer; transition: background 180ms, color 180ms; }
  .filters button[aria-pressed='true'] { background: var(--blue-metal); color: white; border-color: var(--blue-light); box-shadow: inset 0 1px #ffffff40; }
  .filters button:hover { border-color: var(--blue-light); }
  .result-count { margin: 0; font: 9px var(--mono-font); color: var(--text-muted); }
  .projects-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 26px; }
  .project { min-width: 0; overflow: hidden; border: 1px solid var(--border); border-radius: 4px; background: var(--background-light); transition: border-color 350ms, box-shadow 350ms, opacity 700ms ease, transform 700ms cubic-bezier(.22,.61,.36,1); }
  .project:hover { border-color: color-mix(in srgb, var(--project-accent) 55%, transparent); box-shadow: 0 15px 50px #08152d30; }
  .project[hidden] { display: none; }
  .motion-enabled .project:not(.is-visible) { opacity: 0; transform: translateY(35px); }
  .project:nth-child(2n + 1) { transition-delay: 70ms; }
  .project-visual { min-width: 0; border-bottom: 1px solid var(--border); }
  .project-content { display: flex; flex-direction: column; padding: 27px; }
  .project-meta { display: flex; justify-content: space-between; gap: 15px; color: var(--project-accent); font: 9px var(--mono-font); text-transform: uppercase; letter-spacing: .1em; }
  .project-index { color: var(--text-muted); }
  h3 { font: 500 clamp(25px, 2.5vw, 36px)/1.15 var(--title-font); margin: 18px 0 14px; letter-spacing: -.025em; text-wrap: balance; }
  .description { margin: 0; font-size: 12px; line-height: 1.9; color: var(--text-muted); }
  .project-bottom { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 25px; padding-top: 18px; border-top: 1px solid var(--border); }
  .project-domain { font: 9px var(--mono-font); color: var(--text-muted); overflow-wrap: anywhere; }
  .project-visit { display: flex; gap: 12px; align-items: center; font-size: 10px; color: var(--text); }
  .project-visit > span { font-size: 19px; color: var(--project-accent); }
  .project-visit:hover { color: var(--project-accent); }
  .project-featured { grid-column: 1 / -1; display: grid; grid-template-columns: 1.15fr 1fr; }
  .project-featured .project-visual { display: grid; align-items: center; border-bottom: 0; border-right: 1px solid var(--border); background: #0b1d3b; }
  .project-featured .project-content { justify-content: center; padding: 36px; }
  .site-selector { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 24px; }
  .site-selector button { padding: 8px 10px; border: 1px solid var(--border); color: var(--text-muted); background: transparent; font-size: 9px; cursor: pointer; }
  .site-selector button[aria-pressed='true'] { color: var(--project-accent); border-color: var(--project-accent); background: color-mix(in srgb, var(--project-accent) 7%, transparent); }
  .archive-footer { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-top: 35px; font: 9px/1.8 var(--mono-font); color: var(--text-muted); }
  .archive-footer a { color: var(--blue-light); }
  .preview-dialog { width: min(1100px, 94vw); max-width: none; height: 90svh; max-height: none; padding: 0; border: 1px solid var(--border); border-radius: 5px; background: var(--background); color: var(--text); overflow: hidden; }
  .preview-dialog[open] { display: flex; flex-direction: column; }
  .preview-dialog::backdrop { background: #07132aeb; backdrop-filter: blur(8px); }
  .preview-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 20px; border-bottom: 1px solid var(--border); }
  .preview-heading h3 { margin: 0; font: 12px/1.5 var(--mono-font); }
  .preview-heading button { flex-shrink: 0; padding: 9px 12px; background: var(--surface); color: var(--text); cursor: pointer; font-size: 11px; }
  .preview-scroll { overflow: auto; padding: 20px; }
  .preview-image { display: block; width: 100%; height: auto; margin: 0 auto; }
  .preview-dialog[data-mode='mobile'] .preview-image { width: min(100%, 390px); }
  @media (max-width: 1100px) { .project-featured { grid-template-columns: 1fr; } .project-featured .project-visual { border-right: 0; border-bottom: 1px solid var(--border); } .project-featured .project-visual :global(.device-stage) { padding-left: 70px; padding-right: 70px; } }
  @media (max-width: 900px) { .projects-grid { grid-template-columns: 1fr; } .project-content { padding: 25px; } }
  @media (max-width: 480px) { .header-bottom { align-items: flex-start; flex-direction: column; gap: 20px; } .project-featured .project-content { padding: 25px; } .project-featured .project-visual :global(.device-stage) { padding-left: 18px; padding-right: 18px; } .filters button { padding: 9px 12px; font-size: 10px; } .preview-scroll { padding: 8px; } }
  @media (prefers-reduced-motion: reduce) { .motion-enabled .project:not(.is-visible) { opacity: 1; transform: none; } }
  .site-detail { padding: 22px 0; margin-top: 20px; border-top: 1px solid var(--border); } .site-detail h4 { margin: 0 0 12px; font: 500 23px var(--title-font); } .site-detail p { margin: 0; font-size: 12px; line-height: 1.85; color: var(--text-muted); } .site-detail ul { padding: 0; margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 8px; list-style: none; } .site-detail li { padding: 7px 9px; border: 1px solid var(--border); border-radius: var(--radius-panel); font-size: 9px; color: var(--blue-light); }
</style>
