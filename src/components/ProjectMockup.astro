---
interface Capture { src: string; width: number; height: number; }
interface Props { name: string; domain: string; desktop?: Capture | null; mobile?: Capture | null; lang: 'es' | 'en'; }
const { name, domain, desktop, mobile, lang } = Astro.props;
const es = lang === 'es';
---
<div class="device-stage">
  <div class="stage-grid" aria-hidden="true"></div>
  <span class="stage-label" aria-hidden="true">{es ? 'DISEÑO ADAPTABLE / EXPERIENCIA WEB' : 'RESPONSIVE / WEB EXPERIENCE'}</span>
  <div class="devices">
    <div class="monitor">
      <div class="monitor-body">
        <div class="browser-bar" aria-hidden="true"><span class="browser-dots">● ● ●</span><span class="browser-domain">{domain}</span><span>↗</span></div>
        <button class="screen desktop-screen" type="button" data-preview="desktop" disabled={!desktop} aria-label={`${es ? 'Ampliar vista de escritorio de' : 'Enlarge desktop view of'} ${name}`}>
          <img data-device="desktop" src={desktop?.src} alt={`${name} — ${es ? 'captura en escritorio' : 'desktop screenshot'}`} width={desktop?.width || 1440} height={desktop?.height || 900} loading="lazy" decoding="async" hidden={!desktop} />
          <span class="unavailable" hidden={!!desktop}><span class="archive-mark" aria-hidden="true">⌁</span><span>{es ? 'Proyecto del archivo' : 'Archived project'}</span><small>{es ? 'Vista previa no disponible' : 'Preview unavailable'}</small></span>
          <span class="zoom-label" hidden={!desktop}>{es ? 'Ampliar' : 'Enlarge'} ↗</span>
        </button>
        <div class="monitor-chin" aria-hidden="true"><span></span></div>
      </div>
      <div class="monitor-neck" aria-hidden="true"></div><div class="monitor-foot" aria-hidden="true"></div>
    </div>
    <div class="phone">
      <span class="phone-camera" aria-hidden="true"></span>
      <button class="screen mobile-screen" type="button" data-preview="mobile" disabled={!mobile} aria-label={`${es ? 'Ampliar vista móvil de' : 'Enlarge mobile view of'} ${name}`}>
        <img data-device="mobile" src={mobile?.src} alt={`${name} — ${es ? 'captura en móvil' : 'mobile screenshot'}`} width={mobile?.width || 390} height={mobile?.height || 844} loading="lazy" decoding="async" hidden={!mobile} />
        <span class="unavailable" hidden={!!mobile}><span class="archive-mark" aria-hidden="true">⌁</span><small>{es ? 'Sin captura' : 'No capture'}</small></span>
      </button>
      <span class="phone-home" aria-hidden="true"></span>
    </div>
  </div>
</div>
<style>
  .device-stage { position: relative; padding: 56px 28px 28px; overflow: hidden; isolation: isolate; background: radial-gradient(ellipse at 50% 50%, color-mix(in srgb, var(--project-accent) 13%, transparent), transparent 70%), #0b1d3b; }
  .stage-grid { position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(#ffffff04 1px, transparent 1px), linear-gradient(90deg, #ffffff04 1px, transparent 1px); background-size: 32px 32px; mask-image: radial-gradient(ellipse, black, transparent 75%); }
  .stage-label { position: absolute; top: 22px; left: 24px; font: 8px var(--mono-font); letter-spacing: .12em; color: var(--project-accent); opacity: .8; }
  .devices { position: relative; padding-right: 11%; transform: perspective(1000px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg)); transition: transform 350ms ease; }
  .monitor { width: 100%; filter: drop-shadow(0 22px 20px #08152d70); }
  .monitor-body { padding: 6px 6px 0; border: 1px solid #568bdb4a; border-radius: 10px; background: linear-gradient(145deg, #244b7d, #0b1d3b 50%, #315f94); }
  .browser-bar { display: flex; justify-content: space-between; align-items: center; gap: 8px; height: 23px; padding: 0 8px; background: #102a4e; font: 6px var(--mono-font); color: #ffffffb3; border-radius: 5px 5px 0 0; }
  .browser-dots { letter-spacing: 2px; color: var(--project-accent); }
  .browser-domain { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .screen { position: relative; display: block; width: 100%; padding: 0; overflow: hidden; background: #102a4e; color: var(--text); cursor: zoom-in; }
  .desktop-screen { aspect-ratio: 16 / 10; }
  .screen img { width: 100%; height: auto; max-width: none; transform: translateY(0); transition: transform 3.5s cubic-bezier(.22,.61,.36,1); }
  .screen:hover img, .screen:focus-visible img { transform: translateY(-22%); }
  .screen img[hidden], .screen span[hidden] { display: none; }
  .screen:disabled { cursor: default; }
  .monitor-chin { height: 20px; display: grid; place-items: center; }
  .monitor-chin span { width: 4px; height: 4px; border-radius: 50%; background: var(--project-accent); box-shadow: 0 0 10px var(--project-accent); }
  .monitor-neck { width: 16%; height: 22px; margin: 0 auto; background: linear-gradient(90deg, #173a69, #4774a9, #173a69); clip-path: polygon(15% 0, 85% 0, 100% 100%, 0 100%); }
  .monitor-foot { width: 38%; height: 6px; margin: 0 auto; background: linear-gradient(90deg, #244b7d, #568bdb, #244b7d); border-radius: 50% 50% 3px 3px; }
  .phone { position: absolute; bottom: 9px; right: 0; width: 23%; padding: 6px; border: 1px solid #568bdb; border-radius: 18px; background: linear-gradient(145deg, #315f94, #0b1d3b 50%, #4774a9); box-shadow: -14px 14px 25px #08152d80; transform: translateY(var(--phone-y, 0px)) rotate(4deg); transition: transform 700ms cubic-bezier(.22,.61,.36,1); }
  .mobile-screen { aspect-ratio: 390 / 844; border-radius: 12px; }
  .phone-camera { position: absolute; z-index: 2; top: 10px; left: 35%; width: 30%; height: 5px; border-radius: 9px; background: #08152d; }
  .phone-home { position: absolute; bottom: 9px; left: 35%; width: 30%; height: 2px; border-radius: 3px; background: #ffffffaa; }
  .unavailable { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 10px; text-align: center; font: 10px var(--mono-font); color: var(--text-muted); }
  .archive-mark { color: var(--project-accent); font-size: 35px; }
  .unavailable small { font-size: 8px; line-height: 1.5; }
  .zoom-label { position: absolute; bottom: 9px; right: 9px; padding: 5px 8px; border-radius: 3px; background: #08152dd9; font: 8px var(--mono-font); opacity: 0; transition: opacity 200ms; }
  .screen:hover .zoom-label, .screen:focus-visible .zoom-label { opacity: 1; }
  @media (max-width: 480px) { .device-stage { padding: 48px 18px 24px; } .phone { padding: 4px; border-radius: 14px; } .mobile-screen { border-radius: 10px; } .monitor-neck { height: 18px; } }
  @media (prefers-reduced-motion: reduce) { .screen:hover img, .screen:focus-visible img { transform: none; } .devices, .phone { transform: none; } }
</style>
