---
import { interfaceContent } from '../content/interface';
import TechnologyCatalogue from './TechnologyCatalogue.astro';
interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const es = lang === 'es';
const groups = interfaceContent[lang].skills.groups;
const centers = [ ['Django', 'Laravel'], [es ? 'Personas' : 'People', es ? 'Procesos' : 'Processes'], ['Python', es ? 'Datos' : 'Data'] ];
const education = es ? [
  { title: 'Grado Superior en Desarrollo de Aplicaciones Web', center: 'Instituto MEDAC', period: '2020–2022' },
  { title: 'Grado en Administración y Dirección de Empresas', center: 'Universidad de Córdoba', period: '2016–2020', note: 'Especialización en Marketing y Mercados Financieros' },
  { title: 'Máster en Visual Analytics y Big Data', center: 'UNIR', period: 'En curso · según CV de junio de 2026' },
] : [
  { title: 'Higher Vocational Diploma in Web Application Development', center: 'Instituto MEDAC', period: '2020–2022' },
  { title: 'Degree in Business Administration and Management', center: 'Universidad de Córdoba', period: '2016–2020', note: 'Specialization in Marketing and Financial Markets' },
  { title: 'Master’s in Visual Analytics and Big Data', center: 'UNIR', period: 'In progress · as of June 2026 CV' },
];

---
<skills-console data-lang={lang}>
  <section id="skills">
    <h2 data-motion>{interfaceContent[lang].skills.title}</h2>
    <div class="capability-layout">
      <div class="capability-orbit" data-motion="left" data-active="0" role="group" aria-label={es ? 'Núcleo interactivo de habilidades' : 'Interactive skills core'}><div class="orbit-ring" aria-hidden="true"></div><div class="orbit-ring second" aria-hidden="true"></div><div class="orbit-ring third" aria-hidden="true"></div>
        <div class="satellite-track">
        <button type="button" class="satellite one" data-node="code" aria-label={es ? 'Explorar desarrollo web' : 'Explore web development'} aria-pressed="true">&lt;/&gt;</button>
        <button type="button" class="satellite two" data-node="data" aria-label={es ? 'Explorar ciencia de datos' : 'Explore Data Science'} aria-pressed="false">{es ? 'DATOS' : 'DATA'}</button>
        <button type="button" class="satellite three" data-node="api" aria-label={es ? 'Explorar desarrollo de API' : 'Explore API development'} aria-pressed="false">API</button>
        </div>
        <button type="button" class="skill-core" aria-label={es ? 'Cambiar área de habilidades' : 'Switch skills area'}><span data-center-primary>{centers[0][0]}</span><strong data-center-secondary>{centers[0][1]}</strong><small>{es ? 'EXPLORAR' : 'EXPLORE'} ↗</small></button>
      </div>
      <div class="capability-console" data-motion="right">
        <div class="skill-tabs" role="tablist" aria-label={es ? 'Áreas de habilidades' : 'Skill areas'}>{groups.map((group, i) => <button id={`skill-tab-${i}`} type="button" role="tab" aria-selected={i === 0} aria-controls={`skill-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-index={i} data-center={JSON.stringify(centers[i])}>{group.title}</button>)}</div>
        {groups.map((group, i) => <div role="tabpanel" id={`skill-panel-${i}`} aria-labelledby={`skill-tab-${i}`} tabindex="0" hidden={i !== 0}><ul class="skill-chips">{group.items.map((item, n) => <li class="glass-panel" style={`--chip-delay:${n * 45}ms`}><span aria-hidden="true">↗</span>{item}</li>)}</ul><div class="education-record glass-panel"><span class="education-label">{es ? 'Formación' : 'Education'}</span><h3>{education[i].title}</h3><p class="education-center">{education[i].center}</p><p>{education[i].period}</p>{education[i].note && <p>{education[i].note}</p>}</div></div>)}
      </div>
    </div>
    <TechnologyCatalogue lang={lang} />
  </section>
</skills-console>
<script>
  class SkillsConsole extends HTMLElement {
    connectedCallback() {
      const orbit = this.querySelector<HTMLElement>('.capability-orbit')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>('[role=tab]'));
      let orbitTurn = 0;
      const select = (tab: HTMLButtonElement) => {
        tabs.forEach(item => { item.setAttribute('aria-selected', String(item === tab)); item.tabIndex = item === tab ? 0 : -1; });
        this.querySelectorAll<HTMLElement>('[role=tabpanel]').forEach((panel, i) => panel.hidden = i !== Number(tab.dataset.index));
        const [primary, secondary] = JSON.parse(tab.dataset.center || '[]');
        const first = this.querySelector('[data-center-primary]'); const second = this.querySelector('[data-center-secondary]');
        if (first) first.textContent = primary; if (second) second.textContent = secondary;
        orbit.dataset.active = tab.dataset.index;
        orbitTurn += 120;
        orbit.style.setProperty('--orbit-turn', `${orbitTurn}deg`);
        if (!reduced.matches) {
          this.querySelectorAll<HTMLElement>('.orbit-ring').forEach((ring, i) => {
            ring.getAnimations().filter(animation => !(animation instanceof CSSAnimation)).forEach(animation => animation.cancel());
            ring.animate([{ rotate: '0deg' }, { rotate: `${i % 2 ? -360 : 360}deg` }], { duration: 1000, easing: 'cubic-bezier(.16,1,.3,1)' });
          });
        }
        this.querySelectorAll<HTMLElement>('[data-node]').forEach(node => node.setAttribute('aria-pressed', String(node.dataset.node === (tab.dataset.index === '2' ? 'data' : tab.dataset.index === '0' ? 'code' : ''))));
        if (!reduced.matches) this.querySelector('.skill-core')?.animate([{ transform: 'scale(.9)', filter: 'brightness(1.5)' }, { transform: 'scale(1)', filter: 'brightness(1)' }], { duration: 500, easing: 'ease-out' });
      };
      tabs.forEach((tab, i) => { tab.onclick = () => select(tab); tab.onkeydown = event => { const offset = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0; if (offset || event.key === 'Home' || event.key === 'End') { event.preventDefault(); const next = tabs[event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (i + offset + tabs.length) % tabs.length]; select(next); next.focus(); } }; });
      this.querySelectorAll<HTMLButtonElement>('[data-node]').forEach(node => node.onclick = () => {
        select(tabs[node.dataset.node === 'data' ? 2 : 0]);
        if (node.dataset.node === 'api') {
          this.querySelector('[data-center-primary]')!.textContent = 'Django';
          this.querySelector('[data-center-secondary]')!.textContent = 'REST API';
          this.querySelectorAll('[data-node]').forEach(item => item.setAttribute('aria-pressed', String(item === node)));
        }
      });
      this.querySelector<HTMLButtonElement>('.skill-core')!.onclick = () => select(tabs[(Number(orbit.dataset.active) + 1) % tabs.length]);
      orbit.onpointermove = event => {
        if (reduced.matches || event.pointerType === 'touch') return;
        const box = orbit.getBoundingClientRect();
        orbit.style.setProperty('--orbit-x', `${(event.clientX - box.left - box.width / 2) / 25}px`);
        orbit.style.setProperty('--orbit-y', `${(event.clientY - box.top - box.height / 2) / 25}px`);
      };
      orbit.onpointerleave = () => { orbit.style.setProperty('--orbit-x', '0px'); orbit.style.setProperty('--orbit-y', '0px'); };

    }
  }
  if (!customElements.get('skills-console')) customElements.define('skills-console', SkillsConsole);
</script>
<style>
  skills-console { display: block; } section { padding: clamp(80px, 9vw, 130px) clamp(28px, 6vw, 100px); overflow: hidden; border-top: 1px solid var(--border); background: radial-gradient(ellipse at 10% 70%, #568bdb1c, transparent 65%), var(--background-light); }
  h2 { font: 500 clamp(38px, 4.8vw, 70px)/1.08 var(--title-font); letter-spacing: -.04em; margin: 0; }
  .capability-layout { display: grid; grid-template-columns: .85fr 1.15fr; gap: 50px; align-items: center; margin-top: 65px; }
  .capability-orbit { position: relative; width: min(100%, 310px); aspect-ratio: 1; margin: auto; }
  .satellite-track { position:absolute; inset:0; z-index:1; pointer-events:none; transform:rotate(var(--orbit-turn, 0deg)); transition:transform 1s cubic-bezier(.16,1,.3,1); }
  .satellite-track .satellite { pointer-events:auto; rotate:calc(-1 * var(--orbit-turn, 0deg)); transition:rotate 1s cubic-bezier(.16,1,.3,1),box-shadow .3s; }
  .orbit-ring { position: absolute; inset: 8%; border: 1px solid #7aa8eb60; border-left: 3px solid var(--red-highlight); border-radius: 50%; animation: capability-spin 30s linear infinite; }
  .second { inset: 0; border-style: dashed; border-left-width: 1px; animation-direction: reverse; }
  .skill-core { padding: 0; color: white; cursor: pointer; transform: translate(var(--orbit-x, 0px), var(--orbit-y, 0px)); transition: transform .25s, box-shadow .3s; position: absolute; inset: 24%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; background: var(--blue-metal); border: 1px solid #ffffff50; border-radius: 50%; box-shadow: inset 0 2px #ffffff30, 0 0 60px #568bdb20; }
  .skill-core span { font: 11px var(--mono-font); } .skill-core strong { font: 500 25px var(--title-font); }
  .satellite { padding: 0; color: white; cursor: pointer; position: absolute; z-index: 1; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: var(--red-metal); border: 1px solid #ffffff40; font: 10px var(--mono-font); animation: capability-float 4s ease-in-out infinite alternate; }
  .one { top: 3%; left: 18%; } .two { right: -2%; top: 47%; animation-delay: -2s; } .three { bottom: 3%; left: 12%; animation-delay: -1s; }
  .skill-core small { font: 7px var(--mono-font); color: #ffffffaa; letter-spacing: .12em; }
  .skill-core:hover, .skill-core:focus-visible { box-shadow: inset 0 2px #ffffff50, 0 0 75px #568bdb60; }
  .satellite[aria-pressed=true] { border: 2px solid white; box-shadow: 0 0 25px #c7192e70; }
  .satellite:hover { filter: brightness(1.3); }
  .third { inset: 17%; border: 1px dotted #ffffff50; animation-duration: 16s; }
  .capability-orbit:hover .orbit-ring { animation-duration: 12s; }
  .capability-orbit[data-active='2'] .skill-core { background: var(--red-metal); }
  .education-record { margin-top: 28px; padding: 22px; border-left: 2px solid var(--blue-light); background: #568bdb09; }
  .education-label { color: var(--blue-light); font: 9px var(--mono-font); text-transform: uppercase; letter-spacing: .12em; }
  .education-record h3 { margin: 12px 0; font: 500 20px/1.4 var(--title-font); }
  .education-record p { font-size: 11px; line-height: 1.7; color: var(--text-muted); margin: 6px 0 0; }
  .education-record .education-center { color: white; font-size: 13px; }
  button:focus-visible { outline: 2px solid var(--blue-light); outline-offset: 5px; }
  .skill-tabs { display: flex; gap: 6px; flex-wrap: wrap; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
  button { padding: 11px 12px; border: 1px solid var(--border); color: var(--text-muted); background: transparent; font-size: 11px; cursor: pointer; }
  button[aria-selected=true] { color: white; background: var(--red-metal); border-color: var(--red-highlight); }
  .skill-chips { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 10px; }
  li { padding: 14px 17px; background: #568bdb09; border: 1px solid var(--border); font-size: 12px; animation: chip-in .35s both; animation-delay: var(--chip-delay); }
  li span { color: var(--blue-light); padding-right: 12px; }
  [hidden] { display: none; }
  @keyframes capability-spin { to { transform: rotate(360deg); } } @keyframes capability-float { to { transform: translateY(-7px); } } @keyframes chip-in { from { opacity: 0; transform: translateY(8px); } }
  @media(max-width: 1050px) { .capability-layout { grid-template-columns: 1fr; gap: 35px; } .capability-orbit { width: 260px; } }
  @media(max-width: 480px) { section { padding: 70px 22px; } .capability-layout { margin-top: 45px; } .capability-orbit { width: 210px; } .skill-core strong { font-size: 20px; } .satellite { width: 44px; height: 44px; font-size: 8px; } }
  @media(prefers-reduced-motion:reduce) { .satellite-track { transform:none; transition:none; } .satellite-track .satellite { rotate:none; transition:none; } }
</style>
