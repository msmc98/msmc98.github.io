---
interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const es = lang === 'es';
const tasks = [
  { id: 'reactor', target: 'profile', label: es ? 'Activa el reactor de la portada' : 'Activate the hero reactor' },
  { id: 'assistant', target: 'jarvis-question', label: es ? 'Haz una pregunta a J.A.R.V.I.S.' : 'Ask J.A.R.V.I.S. a question' },
  { id: 'preview', target: 'projects', label: es ? 'Amplía la captura de un proyecto' : 'Enlarge a project screenshot' },
  { id: 'experience', target: 'experience', label: es ? 'Abre las funciones de un puesto' : 'Open a role’s responsibilities' },
  { id: 'hobby', target: 'hobbies', label: es ? 'Explora una afición' : 'Explore an interest' },
];
---
<secret-protocol data-lang={lang}>
  <button type="button" class="secret-launcher" aria-label={es ? 'Descubrir protocolo secreto de J.A.R.V.I.S.' : 'Discover J.A.R.V.I.S. secret protocol'} aria-expanded="false" aria-controls="quest-panel">
    <svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="13"/><circle cx="16" cy="16" r="8" stroke-dasharray="4 3"/><circle cx="16" cy="16" r="3" fill="currentColor"/></svg>
  </button>
  <dialog class="glass-panel" id="quest-panel" aria-labelledby="quest-title">
    <div class="quest-heading"><h2 id="quest-title">{es ? 'Protocolo secreto' : 'Secret protocol'}</h2><button type="button" data-close-quest aria-label={es ? 'Cerrar tareas' : 'Close tasks'}>×</button></div>
    <p class="quest-count" role="status" aria-live="polite" data-count>0 / {tasks.length} {es ? 'tareas completadas' : 'tasks completed'}</p>
    <progress max={tasks.length} value="0" aria-label={es ? 'Progreso del protocolo secreto' : 'Secret protocol progress'}></progress>
    <ol>{tasks.map(task => <li data-task={task.id}><span class="task-check" aria-hidden="true">○</span><a href={`#${task.target}`}>{task.label}<span class="task-state">{es ? 'Pendiente' : 'Pending'}</span></a></li>)}</ol>
    <div class="quest-actions"><button type="button" data-reward hidden>{es ? 'Ver recompensa' : 'View reward'}</button><button type="button" data-reset>{es ? 'Reiniciar' : 'Reset'}</button></div>
  </dialog>
  <dialog class="reward-dialog glass-panel" aria-labelledby="reward-title">
    <button type="button" data-close-reward aria-label={es ? 'Cerrar recompensa' : 'Close reward'}>×</button>
    <div class="reward-art"><img src="/images/iron-man-reward.webp" width="768" height="768" alt={es ? 'Iron Man con el pulgar levantado celebrando el logro' : 'Iron Man giving a thumbs-up to celebrate the achievement'} loading="lazy" /><span class="reward-ring" aria-hidden="true"></span></div>
    <h2 id="reward-title">{es ? 'Bien, conseguido' : 'Nicely done'}</h2><p>{es ? 'Protocolo completado. J.A.R.V.I.S. aprueba tu misión.' : 'Protocol complete. J.A.R.V.I.S. approves your mission.'}</p>
    <a href="https://emojis.sh/emoji/iron-man-with-one-hand-up-d0WAhiRcwv" target="_blank" rel="noopener noreferrer">{es ? 'Crédito de la imagen' : 'Image credit'} ↗</a>
  </dialog>
</secret-protocol>
<script>
  class SecretProtocol extends HTMLElement {
    private completed = new Set<string>();
    private key = 'portfolio-quest-v1';
    private record = (event: Event) => { const id = (event as CustomEvent<string>).detail; if (['reactor', 'assistant', 'preview', 'experience', 'hobby'].includes(id) && !this.completed.has(id)) { this.completed.add(id); this.persist(); this.render(); if (this.completed.size === 5) this.showReward(); } };
    private panel() { return this.querySelector<HTMLDialogElement>('#quest-panel'); }
    private persist() { try { sessionStorage.setItem(this.key, JSON.stringify([...this.completed])); } catch {} }
    private showReward() { this.panel()?.close(); document.querySelector<HTMLDialogElement>('.hobby-dialog[open]')?.close(); const dialog = this.querySelector<HTMLDialogElement>('.reward-dialog'); if (dialog && !dialog.open) dialog.showModal(); }
    private render() {
      const es = this.dataset.lang === 'es';
      this.querySelectorAll<HTMLElement>('[data-task]').forEach(item => { const done = this.completed.has(item.dataset.task || ''); item.classList.toggle('done', done); const icon = item.querySelector('.task-check'); const state = item.querySelector('.task-state'); if (icon) icon.textContent = done ? '✓' : '○'; if (state) state.textContent = done ? (es ? 'Completada' : 'Complete') : (es ? 'Pendiente' : 'Pending'); });
      const counter = this.querySelector('[data-count]'); if (counter) counter.textContent = `${this.completed.size} / 5 ${es ? 'tareas completadas' : 'tasks completed'}`;
      const progress = this.querySelector('progress'); if (progress) progress.value = this.completed.size;
      const reward = this.querySelector<HTMLButtonElement>('[data-reward]'); if (reward) reward.hidden = this.completed.size !== 5;
      const launcher = this.querySelector('.secret-launcher'); launcher?.setAttribute('aria-expanded', String(!!this.panel()?.open));
    }
    connectedCallback() {
      try { const saved = JSON.parse(sessionStorage.getItem(this.key) || '[]'); if (Array.isArray(saved)) this.completed = new Set(saved.filter(id => ['reactor', 'assistant', 'preview', 'experience', 'hobby'].includes(id))); } catch {}
      document.addEventListener('portfolio:quest', this.record);
      const panel = this.panel(); const launcher = this.querySelector<HTMLButtonElement>('.secret-launcher');
      if (panel && launcher) { launcher.onclick = () => { if (panel.open) panel.close(); else panel.show(); this.render(); }; panel.onclose = () => this.render(); }
      this.querySelector<HTMLButtonElement>('[data-close-quest]')!.onclick = () => panel?.close();
      this.querySelector<HTMLButtonElement>('[data-reset]')!.onclick = () => { this.completed.clear(); this.persist(); this.render(); };
      this.querySelector<HTMLButtonElement>('[data-reward]')!.onclick = () => this.showReward();
      const reward = this.querySelector<HTMLDialogElement>('.reward-dialog');
      this.querySelector<HTMLButtonElement>('[data-close-reward]')!.onclick = () => reward?.close();
      panel?.querySelectorAll<HTMLAnchorElement>('a').forEach(link => { link.onclick = () => { panel.close(); const target = document.getElementById(link.hash.slice(1)); if (target instanceof HTMLInputElement) { target.scrollIntoView({ block: 'center' }); target.focus({ preventScroll: true }); } }; });
      document.querySelectorAll<HTMLButtonElement>('[data-activate-core]').forEach(button => { button.onclick = () => { document.dispatchEvent(new CustomEvent('portfolio:quest', { detail: 'reactor' })); button.classList.add('core-activated'); if (this.completed.size !== 5 && panel && !panel.open) panel.show(); this.render(); }; });
      this.render();
    }
    disconnectedCallback() { document.removeEventListener('portfolio:quest', this.record); }
  }
  if (!customElements.get('secret-protocol')) customElements.define('secret-protocol', SecretProtocol);
</script>
<style>
  secret-protocol { display: inline-block; }
  .secret-launcher { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid var(--border); border-radius: 50%; background: var(--blue-metal); color: white; cursor: pointer; }
  .secret-launcher svg { width: 25px; height: 25px; stroke: currentColor; stroke-width: 1; transition: transform .5s; } .secret-launcher:hover svg { transform: rotate(90deg); }
  #quest-panel { position: fixed; inset: auto var(--floating-inset) 105px auto; z-index: 120; width: min(350px, calc(100vw - 32px)); max-height: 70svh; overflow-y: auto; padding: 24px; margin: 0; border: 1px solid var(--blue-light); border-radius: 8px; background: #0b1d3bf5; backdrop-filter: blur(18px); color: white; box-shadow: 0 12px 50px #08152d80; }
  .quest-heading { display: flex; align-items: center; justify-content: space-between; gap: 16px; } h2 { font: 500 23px var(--title-font); margin: 0; }
  .quest-heading button, [data-close-reward] { display: grid; place-items: center; width: 30px; height: 30px; border: 1px solid var(--border); background: transparent; color: white; font-size: 23px; cursor: pointer; }
  .quest-count { font: 10px var(--mono-font); color: var(--blue-light); margin: 20px 0 12px; }
  progress { width: 100%; height: 4px; accent-color: var(--red-highlight); }
  ol { padding: 0; list-style: none; margin: 20px 0; } li { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--border); } li a { font-size: 11px; line-height: 1.6; flex: 1; } .task-check { color: var(--blue-light); font-size: 18px; } .task-state { display: block; font-size: 8px; color: var(--text-muted); } .done .task-check { color: white; } .done { opacity: .65; }
  .quest-actions { display: flex; gap: 12px; justify-content: space-between; } .quest-actions button { border: 1px solid var(--border); background: var(--blue-metal); color: white; padding: 9px 12px; font-size: 10px; cursor: pointer; } [hidden] { display: none !important; }
  .reward-dialog { position: fixed; width: min(440px, calc(100vw - 32px)); max-height: 90svh; overflow-y: auto; padding: 35px; border: 1px solid var(--blue-light); border-radius: 12px; background: radial-gradient(circle at 50% 30%, #315f94, #08152d 70%); color: white; text-align: center; }
  .reward-dialog::backdrop { background: #08152dec; backdrop-filter: blur(10px); } [data-close-reward] { position: absolute; right: 12px; top: 12px; }
  .reward-art { position: relative; margin: 15px auto 25px; width: 230px; max-width: 100%; aspect-ratio: 1; display: grid; place-items: center; } .reward-art img { position: relative; z-index: 1; width: 90%; height: 90%; object-fit: contain; border-radius: 50%; animation: reward-pop .7s cubic-bezier(.2,.7,.2,1) both; }
  .reward-ring { position: absolute; inset: 0; border: 2px dashed var(--blue-light); border-top-color: var(--red-highlight); border-radius: 50%; animation: reward-spin 25s linear infinite; }
  .reward-dialog h2 { font-size: 35px; } .reward-dialog p { font-size: 12px; color: var(--text-muted); line-height: 1.8; } .reward-dialog a { font-size: 9px; color: var(--blue-light); }
  @keyframes reward-pop { from { opacity: 0; transform: scale(.7) rotate(-8deg); } } @keyframes reward-spin { to { transform: rotate(360deg); } }
  @media(max-width: 600px) { #quest-panel { right: var(--floating-inset); bottom: 85px; } }
</style>
