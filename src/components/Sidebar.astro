---
import { publicPath } from '../content/paths';
import BrandMark from "./BrandMark.astro";
import LanguageFlag from './LanguageFlag.astro';
import { content as en } from "../content/en";
import { content as es } from "../content/es";

interface Props {
	lang?: "en" | "es";
}

const { lang = "en" } = Astro.props;
const content = lang === "es" ? es : en;

const englishUrl = publicPath("/");
const spanishUrl = publicPath("/es/");
---

<aside class="sidebar">
	<div class="sidebar-inner">

		<!-- Brand -->
		<a href={lang === "en" ? englishUrl : spanishUrl} class="brand" aria-label={lang === 'es' ? 'mzdev · Inicio del portfolio' : 'mzdev · Portfolio home'}>
			<BrandMark />
		</a>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="portfolio-menu" aria-label={lang === 'es' ? 'Abrir menú' : 'Open menu'} data-open-label={lang === 'es' ? 'Abrir menú' : 'Open menu'} data-close-label={lang === 'es' ? 'Cerrar menú' : 'Close menu'}>
			<span class="menu-toggle-label">{lang === 'es' ? 'Menú' : 'Menu'}</span>
			<span class="menu-toggle-icon" aria-hidden="true"><span></span><span></span><span></span></span>
		</button>

		<!-- Navigation -->
		<div class="menu-panel" id="portfolio-menu">
		<nav class="navigation" aria-label={lang === 'es' ? 'Navegación principal' : 'Main navigation'}>

			<a href="#profile" class="nav-item active" aria-current="location">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="12" cy="8" r="3.5" />
					<path d="M5 20C5.8 15.9 8.1 14 12 14C15.9 14 18.2 15.9 19 20" />
				</svg>
				<span>{content.navigation.profile}</span>
			</a>

			<a href="#projects" class="nav-item">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<rect x="4" y="4" width="16" height="16" rx="2" />
					<path d="M8 9H16M8 13H13M8 17H11" />
				</svg>
				<span>{content.navigation.projects}</span>
			</a>

			<a href="#profile-details" class="nav-item">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<circle cx="12" cy="8" r="3.5" />
					<path d="M5 20C5.8 15.9 8.1 14 12 14C15.9 14 18.2 15.9 19 20" />
				</svg>
				<span>{lang === 'es' ? 'Cómo trabajo' : 'How I work'}</span>
			</a>

			<a href="#experience" class="nav-item">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<rect x="4" y="7" width="16" height="12" rx="2" />
					<path d="M9 7V5H15V7M4 11H20M10 11V13H14V11" />
				</svg>
				<span>{content.navigation.experience}</span>
			</a>

			<a href="#skills" class="nav-item">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<path d="M12 3L14.2 8.8L20 11L14.2 13.2L12 19L9.8 13.2L4 11L9.8 8.8L12 3Z" />
					<circle cx="18" cy="18" r="2" />
				</svg>
				<span>{content.navigation.skills}</span>
			</a>

			<a href="#hobbies" class="nav-item">
				<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
					<rect x="3.5" y="5" width="17" height="14" rx="2" />
					<path d="M4 7L12 13L20 7" />
				</svg>
				<span>{lang === 'es' ? 'Aficiones' : 'Interests'}</span>
			</a>

		<a href="#contact" class="nav-item"><span aria-hidden="true">↗</span><span>{content.navigation.contact}</span></a>
		</nav>

		<!-- Bottom area -->
		<div class="sidebar-bottom">

			<div class="language-selector">
				<span class="language-label">{content.language.label}</span>

				<div class="language-options">
					<a
						href={englishUrl} hreflang="en" lang="en" aria-label="English" data-language-link
						class:list={{ selected: lang === "en" }}
						aria-current={lang === "en" ? "true" : undefined}
					>
						<LanguageFlag lang="en" /><span class="language-code">EN</span>
						<span class="language-indicator"></span>
					</a>

					<a
						href={spanishUrl} hreflang="es" lang="es" aria-label="Español" data-language-link
						class:list={{ selected: lang === "es" }}
						aria-current={lang === "es" ? "true" : undefined}
					>
						<LanguageFlag lang="es" /><span class="language-code">ES</span>
						<span class="language-indicator"></span>
					</a>
				</div>
			</div>

			<div class="system-status">
				<div class="status-line">
					<span class="status-dot"></span>
					<span>{content.system.label}</span>
					<strong>{content.system.status}</strong>
				</div>

				<span class="location">{content.system.location}</span>
			</div>

		</div>

		</div>
	</div>
</aside>

<script>
  const sidebar = document.querySelector<HTMLElement>('.sidebar')!;
  const menuToggle = sidebar.querySelector<HTMLButtonElement>('.menu-toggle')!;
  const menuPanel = sidebar.querySelector<HTMLElement>('.menu-panel')!;
  const mobileMenu = window.matchMedia('(max-width: 760px)');
  function setMenuOpen(open: boolean, restoreFocus = false) {
    const expanded = mobileMenu.matches && open;
    sidebar.classList.toggle('menu-open', expanded);
    menuToggle.setAttribute('aria-expanded', String(expanded));
    menuToggle.setAttribute('aria-label', (expanded ? menuToggle.dataset.closeLabel : menuToggle.dataset.openLabel)!);
    menuPanel.inert = mobileMenu.matches && !expanded;
    if (restoreFocus && mobileMenu.matches) menuToggle.focus({ preventScroll: true });
  }
  menuToggle.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));
  menuPanel.addEventListener('click', event => {
    if ((event.target as Element).closest('a')) setMenuOpen(false, true);
  });
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menuToggle.getAttribute('aria-expanded') === 'true') setMenuOpen(false, true);
  });
  document.addEventListener('pointerdown', event => {
    if (!sidebar.contains(event.target as Node)) setMenuOpen(false, menuPanel.contains(document.activeElement));
  });
  sidebar.addEventListener('focusout', () => {
    requestAnimationFrame(() => { if (!sidebar.contains(document.activeElement)) setMenuOpen(false); });
  });
  mobileMenu.addEventListener('change', () => setMenuOpen(false, menuPanel.contains(document.activeElement)));
  setMenuOpen(false);
  const navigationLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.navigation .nav-item'));
  const sections = navigationLinks.map((link) => document.getElementById(link.hash.slice(1))).filter((section): section is HTMLElement => Boolean(section)).sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);
  function updateNavigation() {
    let current = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= window.innerHeight * 0.4) current = section;
    }
    for (const link of navigationLinks) {
      const active = link.hash === `#${current?.id}`;
      link.classList.toggle('active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
  }
  let scheduled = false;
  window.addEventListener('scroll', () => {
    if (scheduled) return;
    scheduled = true;
    requestAnimationFrame(() => { updateNavigation(); scheduled = false; });
  }, { passive: true });
  window.addEventListener('resize', updateNavigation);
  updateNavigation();
</script>

<style>
	.menu-toggle { display: none; }
	.menu-panel { display: contents; }
	.sidebar {
		--nav-inline: 13px;
		--nav-icon: 18px;
		--nav-gap: 14px;
		position: fixed;
		inset: 0 auto 0 0;
		width: var(--sidebar-width);
		background:
			repeating-linear-gradient(0deg, #ffc5c503 0 1px, transparent 1px 4px),
			linear-gradient(115deg, transparent 22%, #ffc5c509 34%, transparent 46%),
			linear-gradient(145deg, #571426 0%, #2e0c17 38%, #66172a 66%, #240a14 100%);
		color: #ffadad;
		border-right: 1px solid #e9667640;
		box-shadow: inset -1px 0 #ffadad12, 12px 0 50px #08152d20;
		z-index: 100;
		overflow-y: auto;
	}

	.sidebar-inner {
		height: 100%;
		display: flex;
		flex-direction: column;
		padding: 32px 24px;
	}

	.brand {
		display: flex;
		align-items: center;
		justify-content: center;
		align-self: center;
		padding: 0 4px;
	}





	.navigation {
		display: flex;
		flex-direction: column;
		gap: 5px;
		margin-block: auto;
		padding-block: 24px;
		flex-shrink: 0;
	}

	.nav-item {
		position: relative;
		display: flex;
		align-items: center;
		gap: var(--nav-gap);
		min-height: 48px;
		padding: 0 var(--nav-inline);
		color: #ffffffcc;
		font-size: 12px;
		letter-spacing: 0.04em;
		transition: color 180ms ease, background 180ms ease;
	}

	.nav-item::before {
		content: "";
		position: absolute;
		left: -24px;
		top: 9px;
		bottom: 9px;
		width: 2px;
		background: #ffadad;
		box-shadow: 0 0 12px #ff526b50;
		opacity: 0;
		transition: opacity 180ms ease;
	}

	.nav-item svg {
		width: 18px;
		height: 18px;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.nav-item > :first-child { width: var(--nav-icon); flex: 0 0 var(--nav-icon); }

	.nav-item:hover,
	.nav-item.active {
		color: #ffffff;
		background: #ffadad09;
	}

	.nav-item.active {
		color: #ffffff;
		background: linear-gradient(90deg, #ff69751c, #ff697506);
		box-shadow: inset 0 0 0 1px #ffadad20;
	}

	.nav-item.active::before {
		opacity: 1;
	}

	.sidebar-bottom {
		flex-shrink: 0;
	}

	.language-selector {
		padding: 20px 0;
		padding-inline: var(--nav-inline);
		border-top: 1px solid #e9667630;
		border-bottom: 1px solid #e9667630;
	}

	.language-label {
		display: block;
		margin-inline-start: calc(var(--nav-icon) + var(--nav-gap));
		margin-bottom: 13px;
		color: #ffffffb3;
		font-size: 9px;
		font-family: var(--title-font);
		text-transform: uppercase;
		letter-spacing: 0.14em;
	}

	.language-options {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.language-options a {
		display: grid;
		grid-template-columns: var(--nav-icon) 1fr 6px;
		gap: var(--nav-gap);
		align-items: center;
		justify-content: space-between;
		width: 100%;
		padding: 3px 0;
		color: #ffffffb3;
		font-size: 11px;
		transition: color 180ms ease;
	}

	.language-options a:hover,
	.language-options a.selected {
		color: #ffffff;
	}

	.language-options a.selected {
		color: #ffffff;
	}

	.language-indicator {
		width: 6px;
		height: 6px;
		border: 1px solid currentColor;
		border-radius: 50%;
	}

	.language-options a.selected .language-indicator {
		background: currentColor;
	}

	.system-status {
		padding-top: 20px;
		padding-inline: var(--nav-inline);
	}

	.status-line {
		display: grid;
		grid-template-columns: var(--nav-icon) auto 1fr;
		align-items: center;
		gap: var(--nav-gap);
		color: #ffffffb3;
		font-size: 9px;
		font-family: var(--title-font);
		text-transform: uppercase;
		letter-spacing: 0.1em;
	}

	.status-line strong {
		color: #ffffff;
		font-weight: 500;
	}

	.status-dot {
		justify-self: center;
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #ffadad;
		box-shadow: 0 0 7px rgba(229, 42, 64, 0.55);
	}

	.location {
		display: block;
		margin-inline-start: calc(var(--nav-icon) + var(--nav-gap));
		margin-top: 8px;
		color: #ffffffb3;
		font-size: 9px;
	}

    @media (max-width: 760px) {
	.sidebar {
		--nav-icon: 16px;
		position: relative;
		inset: auto;
		width: 100%;
		height: auto;

		border-right: 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.sidebar-inner {
		height: auto;
		padding: 18px 22px;
	}

	.brand {
		padding: 0;
	}


	.navigation {
		flex-direction: row;
		gap: 4px;

		margin-top: 22px;

		overflow-x: auto;
		padding-bottom: 4px;

		scrollbar-width: none;
	}

	.navigation::-webkit-scrollbar {
		display: none;
	}

	.nav-item {
		flex: 0 0 auto;
		min-height: 40px;
		padding: 0 11px;
		font-size: 10px;
	}

	.nav-item::before {
		left: 0;
		right: 0;
		top: auto;
		bottom: 0;
		width: auto;
		height: 2px;
	}

	.sidebar-bottom {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;

		margin-top: 18px;
	}

	.language-selector {
		padding: 12px 0;
		border-top: 0;
		border-bottom: 0;
	}

	.language-label {
		display: none;
	}

	.language-options {
		flex-direction: row;
		gap: 14px;
	}

	.system-status {
		padding-top: 0;
	}

	.location {
		display: none;
	}
}

@media (max-width: 480px) {
	.sidebar-inner {
		padding: 15px 18px;
	}



	.navigation {
		margin-top: 16px;
	}

	.nav-item {
		min-height: 36px;
		font-size: 9px;
	}

	.system-status {
		display: none;
	}
}

@media (max-width: 760px) {
	.sidebar { position: sticky; top: 0; overflow: visible; }
	.sidebar-inner { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0; padding: 16px 22px; }
	.brand { justify-self: start; align-self: center; }
	.brand :global(.brand-symbol) { width: 46px; }
	.menu-toggle { display: inline-flex; align-items: center; justify-content: center; gap: 14px; min-height: 48px; padding: 0 16px; border: 1px solid #ffadad55; border-radius: 8px; background: linear-gradient(125deg, #811b3050, #240a1490); color: white; box-shadow: inset 0 1px 0 #ffadad20; cursor: pointer; transition: border-color 220ms, box-shadow 220ms; }
	.menu-toggle-label { font: 11px var(--mono-font); text-transform: uppercase; letter-spacing: .12em; }
	.menu-toggle-icon { display: grid; gap: 5px; width: 23px; }
	.menu-toggle-icon span { display: block; height: 2px; width: 23px; background: #ffadad; border-radius: 2px; transition: transform 320ms ease, opacity 200ms, width 320ms ease; }
	.menu-toggle-icon span:nth-child(2) { width: 16px; justify-self: end; }
	.menu-open .menu-toggle { border-color: #ffadad; box-shadow: 0 0 22px #e52a4030, inset 0 1px 0 #ffadad30; }
	.menu-open .menu-toggle-icon span:first-child { transform: translateY(7px) rotate(45deg); }
	.menu-open .menu-toggle-icon span:nth-child(2) { opacity: 0; transform: translateX(-8px); }
	.menu-open .menu-toggle-icon span:last-child { transform: translateY(-7px) rotate(-45deg); }
	.menu-panel { display: block; position: absolute; inset: 100% 0 auto; max-height: calc(100dvh - 85px); overflow-y: auto; overscroll-behavior: contain; padding: 16px 22px 24px; border-bottom: 1px solid #ffadad55; background: repeating-linear-gradient(0deg, #ffc5c504 0 1px, transparent 1px 4px), radial-gradient(ellipse at 100% 0%, #8f102255, transparent 65%), linear-gradient(145deg, #2e0c17, #08152d); box-shadow: 0 25px 45px #08152db3; opacity: 0; visibility: hidden; transform: translateY(-10px); clip-path: inset(0 0 100% 0); transition: clip-path 380ms cubic-bezier(.22, 1, .36, 1), transform 380ms ease, opacity 240ms ease, visibility 380ms; }
	.menu-panel::before { content: ''; display: block; height: 1px; background: linear-gradient(90deg, #ffadad, #7aa8eb, transparent); box-shadow: 0 0 12px #ffadad66; }
	.menu-open .menu-panel { opacity: 1; visibility: visible; transform: translateY(0); clip-path: inset(0); }
	.navigation { flex-direction: column; margin: 12px 0 0; padding: 0; gap: 4px; overflow: visible; counter-reset: menu-item; }
	.nav-item { min-height: 48px; padding: 0 14px; font-size: 13px; border-radius: 6px; transform: translateX(-12px); opacity: 0; transition: transform 280ms ease, opacity 220ms ease, background 180ms; }
	.nav-item::before { inset: 12px auto 12px 0; width: 2px; height: auto; }
	.nav-item::after { counter-increment: menu-item; content: '0' counter(menu-item); margin-left: auto; color: #ffadad80; font: 10px var(--mono-font); }
	.menu-open .nav-item { transform: translateX(0); opacity: 1; }
	.menu-open .nav-item:nth-child(2) { transition-delay: 30ms; }
	.menu-open .nav-item:nth-child(3) { transition-delay: 60ms; }
	.menu-open .nav-item:nth-child(4) { transition-delay: 90ms; }
	.menu-open .nav-item:nth-child(5) { transition-delay: 120ms; }
	.menu-open .nav-item:nth-child(6) { transition-delay: 150ms; }
	.menu-open .nav-item:nth-child(7) { transition-delay: 180ms; }
	.sidebar-bottom { margin-top: 16px; padding-top: 12px; border-top: 1px solid #ffadad25; }
	.language-options a { display: inline-flex; align-items: center; width: auto; min-width: 44px; min-height: 44px; gap: 8px; }
	:global(section[id]) { scroll-margin-top: 100px; }
}
@media (prefers-reduced-motion: reduce) {
	.menu-panel, .nav-item, .menu-toggle, .menu-toggle-icon span { transition: none !important; }
}
</style>
