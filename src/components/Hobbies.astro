---
import Icon from './Icon.astro';
import CategoryArtwork from './CategoryArtwork.astro';
import { hobbies } from '../content/hobbies';
import rawImages from '../data/hobby-images.json';
interface Props { lang: 'es' | 'en'; }
interface HobbyImage { src: string; width: number; height: number; source: string; credit: string; }
const images = rawImages as Record<string, HobbyImage>;
const { lang } = Astro.props;
const es = lang === 'es';
const first = hobbies.find(group => group.id === 'travel')!.items[0];
const firstImage = images[first.id];
const categoryIcons: Record<string,string> = { cinema:'film', anime:'spark', travel:'globe', sports:'sport', animals:'pets', games:'game', music:'music', passions:'football' };
---
<hobby-gallery data-lang={lang}>
  <section id="hobbies">
    <h2 data-motion>{es ? 'Fuera del código' : 'Beyond the code'}</h2>
    <div class="hobby-explorer">
    <div class="hobby-filters" role="group" aria-label={es ? 'Explorar mis aficiones' : 'Explore my interests'}>
      {hobbies.map(group => <button type="button" class="category-tile" data-hobby-filter={group.id} aria-pressed={group.id === 'travel'}><CategoryArtwork category={group.id} /><span class="category-text"><small><Icon name={categoryIcons[group.id]} size={22} /></small><strong>{group.title[lang]}</strong></span><span class="category-count">{group.items.length}</span><span class="category-arrow" aria-hidden="true">↗</span></button>)}
      <button type="button" class="category-all" data-hobby-filter="all" aria-pressed="false">{es ? 'Explorar todo' : 'Explore everything'} <span aria-hidden="true">↗</span></button>
    </div>
    <div class="hobby-stage glass-panel" data-kind="photo">
      <button type="button" class="stage-picture" data-open-feature aria-label={es ? 'Ampliar imagen seleccionada' : 'Enlarge selected image'}><img data-feature-image src={firstImage.src} width={firstImage.width} height={firstImage.height} alt={first.title[lang]} loading="lazy" decoding="async" /><span aria-hidden="true">↗</span></button>
      <div class="stage-content glass-panel"><span class="stage-category" data-feature-category>{es ? 'Viajes' : 'Travel'}</span><h3 data-feature-title>{first.title[lang]}</h3><p data-feature-note hidden></p><a data-feature-source href={firstImage.source} target="_blank" rel="noopener noreferrer">{es ? 'Fuente original' : 'Original source'} ↗</a><div class="stage-navigation"><button type="button" data-feature-step="-1" aria-label={es ? 'Afición anterior' : 'Previous interest'}>←</button><span data-feature-count aria-live="polite" aria-label={es ? 'Imagen 1 de 4' : 'Image 1 of 4'}>{[0,1,2,3].map(i => <i class:list={{active:i===0}} aria-hidden="true"></i>)}</span><button type="button" data-feature-step="1" aria-label={es ? 'Siguiente afición' : 'Next interest'}>→</button></div></div>
    </div>
    </div>
    {hobbies.map(group => <div class="hobby-group" data-group={group.id}>
      <div class="group-heading"><h3>{group.title[lang]}</h3><span><Icon name={categoryIcons[group.id]} /></span></div>
      <div class="hobby-grid">
        {group.items.map(item => { const image = images[item.id]; return <article class:list={['hobby-card', 'glass-panel', item.kind, { motorcycle: item.id === 'kawasaki' }]} data-motion data-item={item.id} data-kind={item.kind}>
          <button class="hobby-image-button" type="button" data-hobby={group.id} data-image={JSON.stringify(image)} data-title={item.title[lang]} aria-label={`${es ? 'Seleccionar' : 'Select'} ${item.title[lang]}`}>
            <img src={image.src} width={image.width} height={image.height} alt={`${item.title[lang]} — ${item.kind === 'photo' ? (es ? 'fotografía' : 'photograph') : (es ? 'imagen original' : 'original artwork')}`} loading="lazy" decoding="async" />
            <span class="zoom-hint" aria-hidden="true">↗</span>
          </button>
          <div class="hobby-content"><h4>{item.title[lang]}</h4><a href={image.source} target="_blank" rel="noopener noreferrer" aria-label={`${es ? 'Fuente de la imagen de' : 'Image source for'} ${item.title[lang]}`}>{es ? 'Fuente' : 'Source'} ↗</a></div>
          {item.id === 'kawasaki' && <p class="motorcycle-note">{es ? 'Mi moto: una Kawasaki Z125. Fotografía del modelo publicada por Kawasaki.' : 'My bike: a Kawasaki Z125. Model photograph published by Kawasaki.'}</p>}
        </article>; })}
      </div>
    </div>)}
  </section>
  <dialog class="hobby-dialog glass-panel" aria-labelledby="hobby-preview-title">
    <div class="dialog-heading"><h3 id="hobby-preview-title"></h3><button type="button" data-close-hobby aria-label={es ? 'Cerrar imagen' : 'Close image'}>×</button></div>
    <img class="hobby-preview" alt="" /><a class="hobby-source" href="#" target="_blank" rel="noopener noreferrer">{es ? 'Ver fuente original' : 'View original source'} ↗</a>
  </dialog>
</hobby-gallery>
<script>
  class HobbyGallery extends HTMLElement {
    connectedCallback() {
      const groups = Array.from(this.querySelectorAll<HTMLElement>('[data-group]'));
      const cards = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-hobby]'));
      const stage = this.querySelector<HTMLElement>('.hobby-stage')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let selected = cards.find(card => card.closest<HTMLElement>('[data-item]')?.dataset.item === 'tokyo') || cards[0];
      const select = (card: HTMLButtonElement, animate = true) => {
        selected = card;
        const previous = this.querySelector<HTMLImageElement>('[data-feature-image]')!;
        this.querySelectorAll('.transition-image').forEach(layer => layer.remove());
        const sameImage = previous.getAttribute('src') === JSON.parse(card.dataset.image || '{}').src;
        if (animate && !sameImage && !reduced.matches && previous.complete && previous.naturalWidth > 0) {
          const outgoing = previous.cloneNode() as HTMLImageElement;
          outgoing.removeAttribute('data-feature-image'); outgoing.alt = ''; outgoing.setAttribute('aria-hidden','true'); outgoing.className = 'transition-image'; outgoing.style.objectFit = getComputedStyle(previous).objectFit; outgoing.style.padding = getComputedStyle(previous).padding;
          previous.parentElement!.append(outgoing);
          const transition = outgoing.animate([{ clipPath: 'polygon(0 0,100% 0,100% 100%,0 100%)', transform: 'scale(1)' }, { clipPath: 'polygon(100% 0,100% 0,100% 100%,100% 100%)', transform: 'scale(1.08)' }], { duration: 750, easing: 'cubic-bezier(.76,0,.24,1)' });
          transition.onfinish = () => outgoing.remove(); transition.oncancel = () => outgoing.remove();
        }
        cards.forEach(item => item.setAttribute('aria-pressed', String(item === card)));
        const data = JSON.parse(card.dataset.image || '{}');
        const image = this.querySelector<HTMLImageElement>('[data-feature-image]')!;
        image.src = data.src; image.width = data.width; image.height = data.height; image.alt = card.dataset.title || '';
        stage.dataset.item = card.closest<HTMLElement>('[data-item]')?.dataset.item;
        this.querySelector('[data-feature-title]')!.textContent = card.dataset.title || '';
        this.querySelector('[data-feature-category]')!.textContent = card.closest('.hobby-group')?.querySelector('h3')?.textContent || '';
        this.querySelector<HTMLAnchorElement>('[data-feature-source]')!.href = data.source;
        stage.dataset.kind = card.closest<HTMLElement>('[data-item]')?.dataset.kind;
        const note = this.querySelector<HTMLElement>('[data-feature-note]')!;
        note.textContent = card.closest('.hobby-card')?.querySelector('.motorcycle-note')?.textContent || '';
        note.hidden = !note.textContent;
        const collection = Array.from(card.closest('.hobby-group')!.querySelectorAll('[data-hobby]'));
        const indicator=this.querySelector('[data-feature-count]')!; indicator.innerHTML=collection.map((item,i)=>`<i class="${item===card?'active':''}" aria-hidden="true"></i>`).join(''); indicator.setAttribute('aria-label',`${this.dataset.lang==='es'?'Imagen':'Image'} ${collection.indexOf(card)+1} ${this.dataset.lang==='es'?'de':'of'} ${collection.length}`);
        this.querySelectorAll<HTMLButtonElement>('[data-feature-step]').forEach(button => button.disabled = collection.length < 2);
        if (animate && !reduced.matches) {
          image.getAnimations().forEach(animation => animation.cancel());
          image.animate([{ transform: 'scale(1.12) translateX(-15px)' }, { transform: 'scale(1) translateX(0)' }], { duration: 850, easing: 'cubic-bezier(.16,1,.3,1)' });
          const title = this.querySelector<HTMLElement>('[data-feature-title]')!;
          title.getAnimations().forEach(animation => animation.cancel());
          title.animate([{ opacity: 0, transform: 'translateY(25px)', filter: 'blur(8px)' }, { opacity: 1, transform: 'translateY(0)', filter: 'blur(0)' }], { duration: 650, easing: 'cubic-bezier(.16,1,.3,1)' });
        }
      };
      const filter = (button: HTMLButtonElement, animate = true) => {
        this.querySelectorAll('[data-hobby-filter]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
        const categoryRail = this.querySelector<HTMLElement>('.hobby-filters')!;
        if (categoryRail.scrollWidth > categoryRail.clientWidth) categoryRail.scrollTo({ left: categoryRail.scrollLeft + button.getBoundingClientRect().left - categoryRail.getBoundingClientRect().left, behavior: animate && !reduced.matches ? 'smooth' : 'instant' });
        groups.forEach(group => { group.hidden = button.dataset.hobbyFilter !== 'all' && group.dataset.group !== button.dataset.hobbyFilter; });
        const group = groups.find(group => !group.hidden);
        if (group) { group.querySelector('.hobby-grid')!.scrollLeft = 0; select(group.querySelector<HTMLButtonElement>('[data-hobby]')!, animate);
          if (animate && !reduced.matches) group.querySelectorAll('.hobby-card').forEach((card, index) => { card.getAnimations().forEach(animation => animation.cancel()); card.animate([{ opacity: 0, transform: 'translateY(30px) rotate(3deg)' }, { opacity: 1, transform: 'translateY(0) rotate(0)' }], { duration: 600, delay: index * 55, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'backwards' }); }); }
      };
      this.querySelectorAll<HTMLButtonElement>('[data-hobby-filter]').forEach(button => button.onclick = () => filter(button));
      filter(this.querySelector<HTMLButtonElement>('[data-hobby-filter=travel]')!, false);
      const step = (direction: number) => {
        const collection = Array.from(selected.closest('.hobby-group')!.querySelectorAll<HTMLButtonElement>('[data-hobby]'));
        const next = collection[(collection.indexOf(selected) + direction + collection.length) % collection.length];
        select(next); const rail = next.closest<HTMLElement>('.hobby-grid')!; rail.scrollTo({ left: rail.scrollLeft + next.getBoundingClientRect().left - rail.getBoundingClientRect().left - (rail.clientWidth - next.clientWidth) / 2, behavior: reduced.matches ? 'instant' : 'smooth' });
      };
      this.querySelectorAll<HTMLButtonElement>('[data-feature-step]').forEach(button => button.onclick = () => step(Number(button.dataset.featureStep)));
      stage.onkeydown = event => { if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') { event.preventDefault(); step(event.key === 'ArrowRight' ? 1 : -1); } };
      let touchStart: number | undefined;
      stage.onpointerdown = event => { if (event.pointerType === 'touch') touchStart = event.clientX; };
      stage.onpointerup = event => { if (touchStart !== undefined && Math.abs(event.clientX - touchStart) > 55) { step(event.clientX < touchStart ? 1 : -1); suppressClick = true; } touchStart = undefined; };
      stage.onpointercancel = () => { touchStart = undefined; };
      let suppressClick = false;
      const dialog = this.querySelector<HTMLDialogElement>('.hobby-dialog');
      cards.forEach(button => { button.onclick = () => { select(button); document.dispatchEvent(new CustomEvent('portfolio:quest', { detail: 'hobby' })); }; });
      this.querySelector<HTMLButtonElement>('[data-open-feature]')!.onclick = () => {
        if (suppressClick) { suppressClick = false; return; }
        if (!dialog) return;
        const data = JSON.parse(selected.dataset.image || '{}'); const image = dialog.querySelector<HTMLImageElement>('.hobby-preview')!;
        image.src = data.src; image.width = data.width; image.height = data.height; image.alt = selected.dataset.title || '';
        dialog.querySelector('#hobby-preview-title')!.textContent = selected.dataset.title || '';
        dialog.querySelector<HTMLAnchorElement>('.hobby-source')!.href = data.source;
        dialog.showModal(); document.dispatchEvent(new CustomEvent('portfolio:quest', { detail: 'hobby' }));
      };
      const close = this.querySelector<HTMLButtonElement>('[data-close-hobby]'); if (close && dialog) { close.onclick = () => dialog.close(); dialog.onclick = event => { if (event.target === dialog) dialog.close(); }; }
    }
  }
  if (!customElements.get('hobby-gallery')) customElements.define('hobby-gallery', HobbyGallery);
</script>
<style>
  hobby-gallery { display: block; } section { padding: clamp(80px, 9vw, 130px) clamp(22px, 5vw, 80px); border-top: 1px solid var(--border); background: var(--background); }
  h2 { font: 500 clamp(38px, 4.8vw, 70px)/1.08 var(--title-font); letter-spacing: -.04em; margin: 0; }
  .hobby-filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 30px 0; }
  .hobby-filters button { border-radius: var(--radius-panel); padding: 10px 14px; border: 1px solid var(--border); background: transparent; color: var(--text-muted); font-size: 11px; cursor: pointer; }
  .hobby-filters button[aria-pressed=true] { background: var(--blue-metal); color: white; border-color: var(--blue-light); }
  .hobby-group { margin-bottom: 55px; } .hobby-group:last-child { margin-bottom: 0; }
  .group-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 22px; }
  .group-heading h3 { margin: 0; font: 500 27px/1.2 var(--title-font); } .group-heading span { color: var(--blue-light); font: 10px var(--mono-font); }
  .hobby-grid { display: flex; gap: 14px; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; padding: 4px 2px 16px; scrollbar-width: thin; scrollbar-color: var(--blue-light) transparent; }
  .hobby-card { flex: 0 0 max(160px, calc((100% - 42px) / 4)); scroll-snap-align: start; min-width: 0; border: 1px solid var(--border); border-radius: 6px; background: var(--background-light); overflow: hidden; transition: border-color .3s; }
  .hobby-card:hover { border-color: #ffffff60; }
  .hobby-image-button { position: relative; display: block; width: 100%; aspect-ratio: 4 / 3; padding: 0; overflow: hidden; background: #fff; cursor: pointer; }
  img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .6s; }
  .poster .hobby-image-button { aspect-ratio: 4 / 3; background: var(--background-light); } .poster img, .art img { object-fit: contain; }
  .art .hobby-image-button { background: var(--background-light); } [data-item=pokemon] .hobby-image-button { background: #fff; }
  .hobby-image-button:hover img { transform: scale(1.025); }
  .zoom-hint { position: absolute; right: 10px; bottom: 10px; display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #08152dd9; color: white; font-size: 17px; }
  .hobby-content { padding: 14px; display: flex; flex-direction: column; align-items: start; justify-content: space-between; gap: 10px; } h4 { font: 500 14px/1.4 var(--title-font); margin: 0; } .hobby-content a { flex-shrink: 0; color: var(--text-muted); font-size: 8px; line-height: 2.5; } a:hover { color: white; }
  .motorcycle { flex-basis: 250px; } .motorcycle .hobby-image-button { aspect-ratio: 2 / 1; } .motorcycle img { object-position: center 60%; } .motorcycle h4 { font-size: 16px; } .motorcycle-note { display: none; font-size: 11px; color: var(--text-muted); line-height: 1.8; padding: 0 16px 20px; margin: 0; }
  .hobby-stage { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(210px, 1fr); min-height: 360px; margin-bottom: 32px; border: 1px solid var(--border); border-radius: 18px; overflow: hidden; background: linear-gradient(145deg, #162e52, #09172f); }
  .stage-picture { position: relative; display: block; border: 0; padding: 0; height: 390px; overflow: hidden; background: #08152d; cursor: zoom-in; touch-action: pan-y; }
  .stage-picture img { object-fit: cover; }
  .stage-picture > span { position: absolute; right: 18px; bottom: 18px; display: grid; place-items: center; width: 42px; height: 42px; border: 1px solid #ffffff70; border-radius: 50%; color: white; background: #08152d90; font-size: 23px; }
  .hobby-stage[data-kind=poster] .stage-picture img, .hobby-stage[data-kind=art] .stage-picture img { object-fit: contain; }
  .stage-content { display: flex; flex-direction: column; align-items: start; padding: clamp(24px, 3vw, 42px); }
  .stage-category { color: var(--blue-light); font: 10px var(--mono-font); letter-spacing: .12em; text-transform: uppercase; }
  .stage-content h3 { margin: 24px 0 20px; font: 500 clamp(28px, 3.5vw, 48px)/1.1 var(--title-font); letter-spacing: -.035em; text-wrap: balance; }
  .stage-content p { font-size: 11px; line-height: 1.8; color: var(--text-muted); margin: 0 0 16px; }
  .stage-content > a { font-size: 10px; color: var(--text-muted); }
  .stage-navigation { display: flex; align-items: center; justify-content: space-between; gap: 20px; width: 100%; margin-top: auto; padding-top: 35px; }
  .stage-navigation button { width: 44px; height: 44px; border: 1px solid #ffffff40; border-radius: 50%; background: var(--blue-metal); color: white; font-size: 20px; cursor: pointer; }
  .stage-navigation button:disabled { opacity: .25; cursor: default; }
  .stage-navigation span { font: 10px var(--mono-font); color: var(--text-muted); }
  .hobby-image-button[aria-pressed=true] { outline: 2px solid var(--red-highlight); outline-offset: -2px; }
  button:focus-visible, a:focus-visible { outline: 2px solid var(--blue-light); outline-offset: 3px; }
  @media(max-width: 650px) { .hobby-stage { grid-template-columns: 1fr; border-radius: 12px; } .stage-picture { height: 260px; } .stage-content { padding: 22px; } .stage-content h3 { margin: 12px 0 16px; font-size: 32px; } .stage-navigation { padding-top: 20px; } .hobby-card { flex-basis: 155px; } .hobby-filters { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 12px; scrollbar-width: none; } .hobby-filters button { flex-shrink: 0; } }
  @media(prefers-reduced-motion: reduce) { img { transition: none; } }
  [hidden] { display: none !important; }
  .hobby-dialog { width: min(850px, calc(100vw - 32px)); max-width: none; max-height: 90svh; padding: 22px; border: 1px solid var(--blue-light); border-radius: 8px; background: var(--background); color: white; overflow-y: auto; }
  .hobby-dialog::backdrop { background: #08152de6; backdrop-filter: blur(10px); }
  .dialog-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 20px; } .dialog-heading h3 { font: 500 22px var(--title-font); margin: 0; } .dialog-heading button { width: 34px; height: 34px; flex-shrink: 0; border: 1px solid var(--border); background: transparent; color: white; font-size: 24px; cursor: pointer; }
  .hobby-preview { height: auto; max-height: 65svh; object-fit: contain; background: var(--background-light); }
  .hobby-source { display: inline-block; font-size: 10px; color: var(--blue-light); margin-top: 18px; }

  @media(max-width: 480px) { section { padding: 70px 22px; } .hobby-grid { gap: 12px; } .hobby-content { flex-direction: column; gap: 4px; padding: 12px; } h4 { font-size: 14px; } .hobby-filters { gap: 6px; } .hobby-filters button { font-size: 10px; padding: 9px 10px; } .motorcycle .hobby-image-button { aspect-ratio: 4 / 3; } }

  .hobby-explorer { display: grid; grid-template-columns: 230px minmax(0,1fr); gap: 22px; margin: 42px 0 35px; }
  .hobby-filters { display: flex; flex-direction: column; flex-wrap: nowrap; gap: 9px; margin: 0; overflow: visible; }
  .category-tile { display: flex; align-items: center; gap: 12px; width: 100%; padding: 10px !important; text-align: left; min-height: 66px; transition: transform .35s,background .35s,border-color .35s; }
  .category-tile img { width: 44px; height: 44px; border-radius: 6px; flex-shrink: 0; object-fit: cover; } .category-tile .category-text { display: block; min-width: 0; } .category-text small { display: block; margin-bottom: 5px; font: 8px var(--mono-font); color: var(--blue-light); } .category-text strong { font-size: 11px; font-weight: 500; line-height: 1.4; } .category-count { margin-left: auto; color: var(--text-muted); font: 8px var(--mono-font); }
  .category-tile[aria-pressed=true] { background: var(--blue-metal); border-color: var(--blue-light); transform: translateX(5px); }
  .category-all { width: 100%; text-align: left; margin-top: 4px; padding: 13px !important; display: flex; justify-content: space-between; }
  .hobby-stage { display: block; position: relative; margin: 0; min-height: 530px; isolation: isolate; }
  .stage-picture { position: absolute; inset: 0; height: 100%; width: 100%; } .stage-picture > span { z-index: 3; right: 18px; top: 18px; bottom: auto; }
  .stage-picture::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, transparent 45%, #08152d80); z-index: 2; }
  .transition-image { position: absolute; inset: 0; z-index: 1; pointer-events: none; }
  .stage-content { position: absolute; left: 20px; right: 20px; bottom: 20px; z-index: 4; padding: 24px; border: 1px solid #ffffff30; display: grid; grid-template-columns: 1fr auto; align-items: center; column-gap: 20px; }
  .stage-category { grid-column: 1; } .stage-content h3 { margin: 12px 0; font-size: clamp(28px,3.4vw,44px); grid-column: 1; } .stage-content > a { grid-column: 1; } .stage-content p { grid-column: 1 / -1; max-width: 60ch; }
  .stage-navigation { grid-column: 2; grid-row: 1 / 4; width: auto; gap: 14px; margin: 0; padding: 0; flex-direction: column; } .stage-navigation span { white-space: nowrap; }
  .hobby-stage[data-kind=poster] .stage-picture img { padding: 20px 20px 170px; } .hobby-stage[data-kind=art] .stage-picture img { padding: 25px 25px 170px; }
  .hobby-card { transition: border-color .3s,transform .4s; } .hobby-card:hover { transform: translateY(-4px); }
  @media(max-width: 1000px) { .hobby-explorer { grid-template-columns: 180px minmax(0,1fr); gap: 16px; } .category-count { display: none; } .category-text strong { font-size: 10px; } .stage-content { padding: 20px; left: 14px; right: 14px; bottom: 14px; } .stage-navigation { gap: 10px; } .stage-content h3 { font-size: 29px; } }
  @media(max-width: 650px) { .hobby-explorer { grid-template-columns: 1fr; margin-top: 30px; } .hobby-filters { flex-direction: row; overflow-x: auto; gap: 8px; padding: 2px 2px 12px; scroll-snap-type: x mandatory; scrollbar-width: none; } .category-tile { flex: 0 0 175px; scroll-snap-align: start; } .category-all { width: 135px; flex-shrink: 0; margin: 0; align-items: center; } .category-tile[aria-pressed=true] { transform: none; } .hobby-stage { min-height: 455px; } .stage-picture { height: 100%; } .stage-content { padding: 20px; left: 14px; right: 14px; bottom: 14px; column-gap: 10px; } .stage-content h3 { font-size: 30px; } .stage-navigation { flex-direction: column; } .stage-navigation button { width: 36px; height: 36px; } .hobby-stage[data-kind=poster] .stage-picture img { padding-bottom: 190px; } }
  [data-feature-count] { display: flex; gap: 6px; } [data-feature-count] :global(i) { display: block; width: 5px; height: 5px; border-radius: 50%; background: #ffffff40; } [data-feature-count] :global(i.active) { background: var(--red-highlight); }
  /* The category rail is an illustrated editorial index; every image uses one frame. */
  .hobby-explorer { grid-template-columns: 340px minmax(0,1fr); gap:24px; }
