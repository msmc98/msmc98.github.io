---
import { publicPath } from '../content/paths';
import ArcReactor from './ArcReactor.astro';
import Icon from './Icon.astro';
import JarvisAssistant from './JarvisAssistant.astro';
import { contact } from '../content/interface';
import { content as en } from '../content/en';
import { content as es } from '../content/es';
interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const content = lang === 'es' ? es : en;
---
<section class="hero" id="profile">
  <div class="hud" aria-hidden="true"><span>{lang === 'es' ? 'SISTEMA PERSONAL / MK.01' : 'PERSONAL OS / MK.01'}</span><span>{lang === 'es' ? 'INTERFAZ: PORTFOLIO' : 'INTERFACE: PORTFOLIO'}</span></div>
  <div class="hero-body">
  <div class="hero-content">
    <h1>Manuel S.<br /><span>Muñoz Cobos</span></h1>
    <p class="hero-role">{content.hero.role}</p>
    <p class="hero-description">{content.hero.description}</p>
    <div class="hero-actions"><a class="button-link primary" href="#contact">{content.hero.contact} ↗</a><a class="button-link" href="#projects">{content.hero.projects} ↓</a></div>
    <div class="hero-links"><a class="hero-cv" href={publicPath('/documents/CV-Manuel-Munoz-Cobos.pdf')} download="CV-Manuel-Munoz-Cobos.pdf"><Icon name="download" size={17} />{content.hero.cvDownload}<span class="cv-format">PDF</span></a><a href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>{contact.github && <a href={contact.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}<a href="#experience">{content.hero.experience} ↓</a></div>
    <details class="assistant-disclosure"><summary>{content.hero.assistant}</summary><JarvisAssistant lang={lang} /></details>
  </div>
  <div class="hero-visual"><button type="button" data-activate-core aria-label={lang === 'es' ? 'Activar núcleo de J.A.R.V.I.S.' : 'Activate J.A.R.V.I.S. core'}><ArcReactor /></button><div class="telemetry" aria-hidden="true"><span>{lang === 'es' ? 'NÚCLEO' : 'CORE'} <b>{lang === 'es' ? 'ESTABLE' : 'STABLE'}</b></span><span>{lang === 'es' ? 'PROTOCOLO' : 'PROTOCOL'} <b>J.A.R.V.I.S.</b></span></div></div>
  </div>
</section>
<style>
  .hero { position: relative; min-height: 0; overflow: hidden; background: radial-gradient(ellipse at 85% 40%, #568bdb18, transparent 60%), var(--background); }
  .hero-body { display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: 32px; align-items: center; padding-block: var(--hero-space); }
  .hud { display: flex; justify-content: space-between; gap: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border); font: 9px var(--mono-font); letter-spacing: .12em; color: var(--text-muted); }
  .hero-content { position: relative; z-index: 1; width: 100%; min-width: 0; }
  .hero-status { display: flex; flex-wrap: wrap; align-items: center; gap: 9px; margin-bottom: 26px; font: 10px var(--mono-font); text-transform: uppercase; letter-spacing: .12em; color: var(--text-muted); }
  .divider { color: var(--red-highlight); }
  h1 { margin: 0; font: 500 clamp(48px, 5.5vw, 86px)/1.02 var(--title-font); letter-spacing: -.045em; overflow-wrap: break-word; }
  h1 span { color: var(--red-highlight); }
  .hero-role { margin: 26px 0 0; color: var(--text); font: 500 clamp(13px, 1.3vw, 17px)/1.5 var(--title-font); text-transform: uppercase; letter-spacing: .08em; }
  h1, .hero-role, .hero-description { text-wrap: balance; }
  .hero-cv { display:inline-flex; gap:10px; align-items:center; margin-top:24px; padding:0 0 9px; border-bottom:1px solid var(--blue-light); color:white; font-size:12px; transition:color .25s,border-color .25s; }
  .hero-cv:hover { color:var(--blue-light); border-color:white; } .cv-format { color:var(--text-muted); font:8px var(--mono-font); margin-left:5px; }
  .hero-visual { position: relative; width: 100%; opacity: .85; }
  .hero-visual > span { display: block; text-align: center; margin-top: 28px; color: var(--blue-light); font: 9px var(--mono-font); letter-spacing: .12em; }
  [data-activate-core] { display: block; width: 100%; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; transition: filter .5s, transform .5s; }
  [data-activate-core]:hover, .core-activated { filter: drop-shadow(0 0 18px #83eaff50); transform: scale(1.035); }
  .telemetry { display: grid; gap: 12px; margin: 28px 35px; font: 9px var(--mono-font); color: var(--text-muted); }
  .telemetry span { display: flex; justify-content: space-between; gap: 12px; }
  .telemetry b { color: var(--text); font-weight: 400; }
  .hero-value { font: 500 clamp(23px, 2.3vw, 32px)/1.35 var(--title-font); max-width: 28ch; margin: 20px 0 12px; text-wrap: balance; }
  .hero-description { color: var(--text-muted); font-size: 14px; line-height: 1.8; }
  .hero-actions, .hero-links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 22px; margin-top: 24px; }
  .hero-links { font-size: 12px; } .hero-cv { margin-top: 0; padding: 10px 0; }
  .assistant-disclosure { margin-top: 24px; }
  @media (max-width: 1250px) { .hero-body { grid-template-columns: minmax(0, 1fr) 260px; gap: 24px; } .telemetry { margin-inline: 0; } }
  @media (max-width: 950px) { .hero-body { grid-template-columns: 1fr; } .hero-visual { width: min(100%, 210px); justify-self: center; } }
  @media (max-width: 760px) { .hero-body { gap: 36px; } h1 { font-size: clamp(40px, 8vw, 62px); } .hero-role { margin-top: 20px; } .hero-value { font-size: 25px; } .telemetry { margin: 24px 0 0; } }
  @media (max-width: 480px) { .hud { font-size: 8px; } .hero-status { font-size: 9px; } }
</style>
