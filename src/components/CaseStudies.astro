---
import { caseStudies, caseLabels } from '../content/case-studies';
import { publicPath } from '../content/paths';
interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const labels = caseLabels[lang];
const optionalFields = ['problem', 'decisions', 'challenges', 'outcome', 'learnings'] as const;
---
<div class="case-studies">
  <div class="case-grid">{caseStudies.map(study => <article class="case-study" id={`case-${study.id}`}>
    <span class="case-type">{study.employer}</span>
    <h4>{study.name}</h4><p>{study.contribution[lang]}</p>
    <ul class="case-stack" aria-label={lang === 'es' ? 'Tecnologías' : 'Technologies'}>{study.technologies.map(tech => <li>{tech}</li>)}</ul>
    <details><summary>{labels.expand}</summary>
      {study.preview && <figure><a href={publicPath(study.preview.src)} target="_blank" rel="noopener noreferrer" aria-label={lang === 'es' ? 'Abrir dashboard anonimizado de ARFE' : 'Open anonymized ARFE dashboard'}><img src={publicPath(study.preview.src)} width={study.preview.width} height={study.preview.height} loading="lazy" decoding="async" alt={lang === 'es' ? 'Dashboard de ARFE con datos ficticios, DNI y números de póliza sustituidos por XXXXXXX' : 'ARFE dashboard with fictional data, IDs and policy numbers replaced by XXXXXXX'} /></a><figcaption>{lang === 'es' ? 'Vista anonimizada con datos ficticios. Ampliar ↗' : 'Anonymized view with fictional data. Enlarge ↗'}</figcaption></figure>}
      <dl><dt>{labels.context}</dt><dd>{study.context[lang]}</dd><dt>{labels.role}</dt><dd>{study.contribution[lang]}</dd><dt>{labels.deliverable}</dt><dd>{study.deliverable[lang]}</dd>{optionalFields.map(key => study[key] && <><dt>{labels[key]}</dt><dd>{study[key]![lang]}</dd></>)}</dl>
      <a href="#experience">{labels.experience} ↓</a>
    </details>
  </article>)}</div>
</div>
<style>
  figure { margin: 20px 0; } figure a { display: block; } figure img { width: 100%; height: auto; border: 1px solid var(--border); border-radius: 6px; } figcaption { margin-top: 8px; font-size: 11px; line-height: 1.7; color: var(--text-muted); }
  .case-studies { margin: 35px 0 50px; } h3 { margin: 0; font: 500 28px/1.3 var(--title-font); }
  .case-intro, .case-study p, dd { color: var(--text-muted); font-size: 13px; line-height: 1.8; }
  .case-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: 24px; }
  .case-study { min-width: 0; padding: 24px; border: 1px solid var(--border); border-top: 2px solid var(--blue-light); background: #0b1d3b; border-radius: var(--radius-panel); scroll-margin-top: 100px; }
  .case-type { font: 10px/1.7 var(--mono-font); color: var(--blue-light); } h4 { font: 500 24px/1.3 var(--title-font); margin: 16px 0; }
  .case-stack { display: flex; flex-wrap: wrap; gap: 8px; margin: 20px 0; padding: 0; list-style: none; } li { padding: 7px 10px; border: 1px solid var(--border); color: var(--text); font: 11px var(--mono-font); }
  dt { font-size: 12px; margin-top: 20px; color: white; } dd { margin: 8px 0 0; } details a { display: inline-flex; align-items: center; min-height: 44px; font-size: 12px; color: var(--blue-light); }
  .case-study .scope { font-size: 11px; } @media(max-width: 1100px) { .case-grid { grid-template-columns: 1fr; } }
</style>
