---
import { contact, interfaceContent } from '../content/interface';
interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const ui = interfaceContent[lang].contact;
---
<section id="contact" aria-labelledby="contact-title">
  <div class="contact-greeting">
    <img class="contact-portrait" src={contact.profilePhoto} width="600" height="600" alt="Manuel S. Muñoz Cobos" loading="lazy" decoding="async" />
    <h2 class="contact-bubble" id="contact-title">{ui.title}</h2>
  </div>
  <div class="contact-intentions">
    {ui.intentions.map(item => <a class="intent" href={`mailto:${contact.email}?subject=${encodeURIComponent(item.subject)}`}><h3>{item.title} <span aria-hidden="true">↗</span></h3></a>)}
  </div>
  <div class="contact-links"><a class="button-link primary" href={`mailto:${contact.email}`}>Email ↗</a><a class="button-link" href={contact.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp ↗</a><a class="button-link" href={contact.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a class="button-link" href={contact.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram: @manu98mz">Instagram · @manu98mz ↗</a></div>
  <p class="location">{ui.location}</p>
</section>
<style>
  section {  border-top: 1px solid var(--border); background: radial-gradient(ellipse at 90% 20%, #568bdb18, transparent 65%); }
  .contact-greeting { display: flex; align-items: center; gap: 32px; }
  .contact-portrait { flex: 0 0 auto; width: clamp(140px, 18vw, 220px); height: auto; }
  .contact-bubble { position: relative; max-width: 15ch; padding: 24px 28px; border: 1px solid #7aa8eb60; border-radius: 24px 24px 24px 4px; background: #17365c; }
  .contact-bubble::before { content: ''; position: absolute; left: -11px; top: calc(50% - 10px); width: 20px; height: 20px; background: #17365c; border-left: 1px solid #7aa8eb60; border-bottom: 1px solid #7aa8eb60; transform: rotate(45deg); }
  @media(max-width: 600px) { .contact-greeting { gap: 18px; } .contact-portrait { width: 100px; } .contact-bubble { padding: 18px; font-size: clamp(23px, 5vw, 30px); } }
  .eyebrow { display: block; color: var(--blue-light); font: 11px/1.6 var(--mono-font); letter-spacing: .08em; }
  h2 { margin: 18px 0; font: 500 clamp(36px, 4.5vw, 64px)/1.1 var(--title-font); letter-spacing: -.035em; }
  .contact-description { max-width: 60ch; font-size: 15px; line-height: 1.8; color: var(--text-muted); }
  .contact-intentions { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; margin: 35px 0; }
  .intent { padding-block: 22px; border-top: 1px solid var(--border); transition: border-color .2s; } .intent:hover { border-color: var(--blue-light); }
  h3 { display: flex; justify-content: space-between; gap: 12px; margin: 0; font: 500 23px/1.4 var(--title-font); } h3 span { color: var(--blue-light); }
  .intent p, .location { color: var(--text-muted); font-size: 13px; line-height: 1.8; }
  .contact-links { display: flex; flex-wrap: wrap; gap: 12px; } .location { margin-top: 28px; }
  @media(max-width: 600px) { .contact-intentions { grid-template-columns: 1fr; gap: 0; } .contact-links { flex-direction: column; align-items: stretch; } }
</style>
