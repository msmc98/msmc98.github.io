---
import { contact } from '../content/interface';
interface Props { lang: 'es' | 'en'; }
const { lang } = Astro.props;
const es = lang === 'es';
---
<nav id="contact-dock" class="contact-dock glass-panel" aria-label={es ? 'Contactar con Manuel' : 'Contact Manuel'} tabindex="-1">
  <a class="email" href={`mailto:${contact.email}`} aria-label={es ? 'Abrir correo para contactar con Manuel' : 'Open email to contact Manuel'}>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m4 7 8 6 8-6"/></svg><span>{es ? 'Correo' : 'Email'}</span>
  </a>
  <a class="whatsapp" href={contact.whatsapp} target="_blank" rel="noopener noreferrer" aria-label={es ? 'Abrir chat de WhatsApp con Manuel' : 'Open a WhatsApp chat with Manuel'}>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-12 7L3 20l1.5-5a8 8 0 1 1 15.5-3.5Z"/><path d="M8 8c0 4 4 7 7 7l1-2-3-1-1 1-2-2 1-1-1-3Z"/></svg><span>WhatsApp</span>
  </a>
</nav>
<script>
  const dock = document.querySelector<HTMLElement>('.contact-dock');
  const contactSection = document.getElementById('contact');
  if (dock && contactSection && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => { dock.hidden = entry.isIntersecting; }).observe(contactSection);
  }
</script>
<style>
  .contact-dock[hidden] { display: none; }
  .contact-dock { position: fixed; z-index: 110; right: var(--floating-inset); bottom: max(24px, env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 10px; padding: 8px; border: 1px solid #ffffff25; border-radius: 50px; background: #08152de6; backdrop-filter: blur(16px); box-shadow: 0 8px 30px #08152d80; }
  a { display: flex; align-items: center; justify-content: center; gap: 9px; height: 48px; padding: 0 17px; border: 1px solid #ffffff30; border-radius: 30px; color: white; font-size: 11px; box-shadow: inset 0 1px #ffffff40; transition: transform .25s, box-shadow .25s; }
  .email { background: var(--red-metal); } .whatsapp { background: var(--blue-metal); }
  a:hover { transform: translateY(-3px); box-shadow: inset 0 1px #ffffff40, 0 5px 20px #568bdb30; }
  svg { width: 20px; height: 20px; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  @media(max-width: 600px) { .contact-dock { right: var(--floating-inset); bottom: max(12px, env(safe-area-inset-bottom)); gap: 6px; padding: 5px; } a { width: 46px; height: 46px; padding: 0; } a span { display: none; } }
</style>
