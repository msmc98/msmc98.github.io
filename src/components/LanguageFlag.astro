---
interface Props { lang: 'en' | 'es'; }
const { lang } = Astro.props;
---
<svg class="language-flag" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 24" aria-hidden="true" focusable="false">
  {lang === 'en' ? <>
    <path fill="#012169" d="M0 0h32v24H0z" />
    <path stroke="#fff" stroke-width="5" d="m0 0 32 24M32 0 0 24" />
    <path stroke="#c8102e" stroke-width="2" d="m0 0 32 24M32 0 0 24" />
    <path stroke="#fff" stroke-width="8" d="M16 0v24M0 12h32" />
    <path stroke="#c8102e" stroke-width="4" d="M16 0v24M0 12h32" />
  </> : <>
    <path fill="#aa151b" d="M0 0h32v24H0z" />
    <path fill="#f1bf00" d="M0 6h32v12H0z" />
    <path fill="#aa151b" d="M9 9h5v5c0 3-5 3-5 0z" />
    <path fill="#fff" d="M10 10h1v3h-1zM12 10h1v3h-1z" />
  </>}
</svg>
<style>
  .language-flag { width: 18px; height: 14px; border-radius: 2px; overflow: hidden; flex-shrink: 0; }
</style>
