---
import Icon from './Icon.astro';
import SectionDisclosure from './SectionDisclosure.astro';
import { professionalRoles } from '../content/professional-roles';
interface Props {
  lang: 'es' | 'en';
	content: {
		eyebrow: string;
		title: string;
		intro: string;
		approach: {
			title: string;
			description: string;
		}[];
		description: string;
	};
}

const { content, lang } = Astro.props;
const es = lang === 'es';
const steps = [content.approach[2], content.approach[1], content.approach[0]];
const phases = es ? ['La idea', 'El plan', 'El producto'] : ['The idea', 'The plan', 'The product'];
---

<profile-process data-lang={lang}>
<section class="profile-section" id="profile-details">
  <h2 data-motion>{es ? 'Cómo trabajo' : 'How I work'}</h2>
  <div class="role-grid">{professionalRoles.map(role => <article class="role-card glass-panel"><h3>{role.title[lang]}</h3><p>{role.description[lang]}</p></article>)}</div>
  <SectionDisclosure label={es ? 'Explorar mi proceso de trabajo' : 'Explore my working process'}>
  <div class="process-shell glass-panel" data-motion data-step="0">
    <div class="process-navigation" role="tablist" aria-label={es ? 'Mi proceso de trabajo' : 'My working process'}>
      {steps.map((step, i) => <button type="button" class="process-step" id={`process-tab-${i}`} role="tab" aria-selected={i === 0} aria-controls={`process-panel-${i}`} tabindex={i === 0 ? 0 : -1} data-process-step={i}><span class="step-number"><Icon name={['chat','plan','code'][i]} /></span><span><small>{phases[i]}</small><strong>{step.title}</strong></span><span class="step-arrow" aria-hidden="true">↗</span></button>)}
    </div>
    <div class="process-body">
      <div class="process-canvas" aria-hidden="true">
        <div class="canvas-grid"></div><div class="signal-route"></div>
        <div class="process-visual conversation" data-visual="0"><div class="idea-orb">?</div><div class="message first">{es ? 'Tengo una idea' : 'I have an idea'}<i></i></div><div class="message second">{es ? 'Vamos a darle forma' : 'Let’s shape it'}<i></i></div><span class="visual-label">{es ? 'ESCUCHAR → ENTENDER' : 'LISTEN → UNDERSTAND'}</span></div>
        <div class="process-visual architecture" data-visual="1" hidden><div class="plan-layer layer-one"><span>{es ? 'Necesidad' : 'Need'}</span><b>◎</b></div><div class="plan-layer layer-two"><span>{es ? 'Solución' : 'Solution'}</span><b>&lt;/&gt;</b></div><div class="plan-layer layer-three"><span>{es ? 'Estructura' : 'Structure'}</span><b>{'{ }'}</b></div><span class="visual-label">{es ? 'ANALIZAR → DISEÑAR' : 'ANALYZE → DESIGN'}</span></div>
        <div class="process-visual delivery" data-visual="2" hidden><div class="product-window"><div class="window-bar"><i></i><i></i><i></i><span>https://</span></div><div class="window-content"><div class="product-mark">&lt;/&gt;</div><div class="product-lines"><i></i><i></i><i></i></div><div class="product-blocks"><i></i><i></i><i></i></div></div></div><div class="delivery-check">✓</div><span class="visual-label">{es ? 'DESARROLLAR → ENTREGAR' : 'DEVELOP → DELIVER'}</span></div>
      </div>
      <div class="process-copy">
        {steps.map((step, i) => <div class="process-panel" id={`process-panel-${i}`} role="tabpanel" aria-labelledby={`process-tab-${i}`} tabindex="0" hidden={i !== 0}><span class="phase-label">{phases[i]}</span><h3>{step.title}</h3><p>{step.description}</p></div>)}
        <div class="process-bottom"><span class="process-progress" aria-hidden="true">{['chat','plan','code'].map((name,i)=><span data-process-marker={i} class:list={{active:i===0}}><Icon name={name} size={16} /></span>)}</span><button type="button" data-process-next>{es ? 'Siguiente paso' : 'Next step'} <span aria-hidden="true">→</span></button></div>
      </div>
    </div>
  </div>
  <div class="profile-footer" data-motion><p>{content.description}</p><a href="#projects">{es ? 'Verlo en mis proyectos' : 'See it in my projects'} ↗</a></div>
  <noscript><div class="process-fallback">{steps.slice(1).map(step => <article><h3>{step.title}</h3><p>{step.description}</p></article>)}</div></noscript>
  </SectionDisclosure>
</section>
</profile-process>
<script>
  class ProfileProcess extends HTMLElement {
    connectedCallback() {
      const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-process-step]'));
      const shell = this.querySelector<HTMLElement>('.process-shell')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      let active = 0;
      const select = (index: number) => {
        if (index === active) return;
        active = index; shell.dataset.step = String(index);
        tabs.forEach((tab, i) => { tab.setAttribute('aria-selected', String(i === index)); tab.tabIndex = i === index ? 0 : -1; });
        this.querySelectorAll<HTMLElement>('.process-panel,[data-visual]').forEach(panel => {
          const current = panel.dataset.visual !== undefined ? Number(panel.dataset.visual) : Number(panel.id.split('-').pop());
          panel.hidden = current !== index;
          if (!panel.hidden && !reduced.matches) { panel.getAnimations().forEach(animation => animation.cancel()); panel.animate([{ opacity: 0, transform: 'translateY(24px) rotateX(-10deg)', clipPath: 'inset(0 0 90% 0)' }, { opacity: 1, transform: 'translateY(0) rotateX(0)', clipPath: 'inset(0)' }], { duration: 650, easing: 'cubic-bezier(.16,1,.3,1)' }); }
        });
        this.querySelectorAll<HTMLElement>('[data-process-marker]').forEach(marker=>marker.classList.toggle('active',Number(marker.dataset.processMarker)===index));
        const next = this.querySelector<HTMLButtonElement>('[data-process-next]')!;
        next.innerHTML = `${index === 2 ? (this.dataset.lang === 'es' ? 'Volver a la idea' : 'Back to the idea') : (this.dataset.lang === 'es' ? 'Siguiente paso' : 'Next step')} <span aria-hidden="true">→</span>`;
      };
      tabs.forEach((tab, i) => { tab.onclick = () => select(i); tab.onkeydown = event => { const keys = ['ArrowRight','ArrowLeft','ArrowDown','ArrowUp','Home','End']; if (!keys.includes(event.key)) return; event.preventDefault(); const index = event.key === 'Home' ? 0 : event.key === 'End' ? 2 : (i + (event.key === 'ArrowLeft' || event.key === 'ArrowUp' ? -1 : 1) + 3) % 3; select(index); tabs[index].focus(); }; });
      this.querySelector<HTMLButtonElement>('[data-process-next]')!.onclick = () => select((active + 1) % 3);
    }
  }
  if (!customElements.get('profile-process')) customElements.define('profile-process', ProfileProcess);
</script>
<style>
  .role-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin-top: var(--section-heading-gap); }
  .role-card { padding: 24px; border: 1px solid var(--border); }
  .role-card h3 { margin: 0; font: 500 23px/1.3 var(--title-font); }
  .role-card p { margin: 14px 0 0; color: var(--text-muted); font-size: 13px; line-height: 1.8; }
  @media(max-width: 1100px) { .role-grid { grid-template-columns: 1fr; } }
  profile-process { display: block; } section { border-top: 1px solid var(--border); background: var(--background-light); }
  h2 { margin: 0; font: 500 clamp(38px,4.8vw,70px)/1.08 var(--title-font); letter-spacing: -.04em; }
  .process-shell { margin-top: 45px; border: 1px solid var(--border); overflow: hidden; }
  .process-navigation { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); border-bottom: 1px solid var(--border); }
  .process-step { display: flex; align-items: center; gap: 16px; text-align: left; padding: 24px; background: transparent; color: var(--text-muted); border-radius: 0; cursor: pointer; position: relative; transition: background .3s,color .3s; }
  .process-step + .process-step { border-left: 1px solid var(--border); }
  .process-step[aria-selected=true] { color: white; background: #568bdb18; }
  .process-step::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--red-highlight); transform: scaleX(0); transform-origin: left; transition: transform .5s; }
  .process-step[aria-selected=true]::after { transform: scaleX(1); }
  .step-number { font: 12px var(--mono-font); color: var(--blue-light); } .process-step small { display: block; font: 9px var(--mono-font); margin-bottom: 7px; } .process-step strong { font: 500 22px var(--title-font); } .step-arrow { margin-left: auto; }
  .process-body { display: grid; grid-template-columns: 1.2fr 1fr; min-height: 360px; }
  .process-canvas { position: relative; overflow: hidden; display: grid; place-items: center; min-height: 360px; border-right: 1px solid var(--border); perspective: 800px; }
  .canvas-grid { position: absolute; inset: 0; background-image: linear-gradient(#7aa8eb0c 1px,transparent 1px),linear-gradient(90deg,#7aa8eb0c 1px,transparent 1px); background-size: 28px 28px; mask-image: radial-gradient(ellipse,black,transparent 80%); }
  .signal-route { position: absolute; inset: 10%; border: 1px solid #7aa8eb30; clip-path: polygon(0 0,40% 0,40% 3%,3% 3%,3% 97%,97% 97%,97% 60%,100% 60%,100% 100%,0 100%); }
  .process-visual { position: relative; width: 100%; height: 300px; } .visual-label { position: absolute; left: 0; right: 0; bottom: 8px; text-align: center; font: 8px var(--mono-font); letter-spacing: .15em; color: var(--blue-light); }
  .idea-orb { position: absolute; top: 38px; left: calc(50% - 43px); width: 86px; height: 86px; display: grid; place-items: center; border: 1px solid #ffffff60; border-radius: 50%; background: var(--red-metal); font: 40px var(--title-font); box-shadow: 0 0 70px #c7192e30; animation: idea-breathe 4s ease-in-out infinite; }
  .message { position: absolute; padding: 17px 22px; background: #17365c; border: 1px solid var(--border); font-size: 12px; box-shadow: 0 12px 30px #08152d55; } .message.first { left: 9%; top: 142px; border-radius: 12px 12px 12px 0; transform: rotate(-4deg); } .message.second { right: 8%; top: 205px; border-radius: 12px 12px 0 12px; transform: rotate(3deg); }
  .plan-layer { position: absolute; width: 62%; height: 76px; left: 19%; display: flex; align-items: center; justify-content: space-between; padding: 22px; border: 1px solid #7aa8eb60; background: #112343; transform: rotate(-9deg) skewX(8deg); box-shadow: 0 15px 30px #08152d60; font: 11px var(--mono-font); } .plan-layer b { color: var(--blue-light); font-size: 20px; }
  .layer-one { top: 40px; z-index: 3; } .layer-two { top: 103px; z-index: 2; background: #17365c; } .layer-three { top: 166px; z-index: 1; background: #244b7d; }
  .product-window { position: absolute; width: 72%; left: 14%; top: 45px; border: 1px solid #7aa8eb80; border-radius: 12px; overflow: hidden; background: #0b1d3b; transform: rotate(-4deg); box-shadow: 12px 20px 0 #568bdb12; } .window-bar { display: flex; gap: 5px; align-items: center; height: 26px; padding: 0 12px; background: #17365c; } .window-bar i { width: 4px; height: 4px; border-radius: 50%; background: white; opacity: .5; } .window-bar span { font: 7px var(--mono-font); margin-left: 12px; color: var(--blue-light); }
  .window-content { padding: 24px; } .product-mark { color: var(--red-highlight); font: 28px var(--title-font); } .product-lines { display: grid; gap: 7px; margin: 15px 0; } .product-lines i { height: 4px; width: 85%; background: #7aa8eb50; } .product-lines i:nth-child(2) { width: 60%; } .product-lines i:nth-child(3) { width: 75%; } .product-blocks { display: flex; gap: 10px; } .product-blocks i { height: 30px; flex: 1; border: 1px solid var(--border); background: #568bdb15; } .delivery-check { position: absolute; bottom: 52px; right: 11%; width: 48px; height: 48px; display: grid; place-items: center; background: var(--red-metal); border: 1px solid #ffffff80; border-radius: 50%; font-size: 24px; }
  .process-copy { padding: clamp(24px,4vw,45px); display: flex; flex-direction: column; justify-content: center; } .phase-label { font: 9px var(--mono-font); color: var(--blue-light); letter-spacing: .12em; text-transform: uppercase; } h3 { font: 500 clamp(32px,4vw,52px)/1.1 var(--title-font); margin: 18px 0; } .process-panel p { font-size: 13px; line-height: 1.9; color: var(--text-muted); margin: 0; }
  .process-bottom { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-top: 32px; } .process-progress { font: 10px var(--mono-font); color: var(--blue-light); } [data-process-next] { padding: 10px 0; background: transparent; color: white; font-size: 10px; cursor: pointer; } [data-process-next] span { margin-left: 12px; color: var(--red-highlight); }
  .profile-footer { display: flex; align-items: center; justify-content: space-between; gap: 35px; margin-top: 30px; } .profile-footer p { max-width: 70ch; margin: 0; font-size: 12px; line-height: 1.9; color: var(--text-muted); } .profile-footer a { flex-shrink: 0; font-size: 10px; color: var(--blue-light); }
  [hidden] { display: none !important; } @keyframes idea-breathe { 50% { box-shadow: 0 0 90px #c7192e50; transform: scale(1.05); } }
  @media(max-width: 950px) { .process-step { padding: 20px 16px; gap: 10px; } .process-step strong { font-size: 18px; } .step-arrow { display: none; } }
  @media(max-width: 650px) { .process-body { grid-template-columns: 1fr; } .process-canvas { border-right: 0; border-bottom: 1px solid var(--border); min-height: 290px; } .process-visual { height: 280px; } .process-step { flex-direction: column; align-items: start; padding: 18px 12px; } .process-step strong { font-size: 16px; } .process-step small { font-size: 8px; } .process-copy { padding: 26px 22px; } .profile-footer { flex-direction: column; align-items: start; gap: 18px; } }
  .process-progress { display: flex; gap: 14px; } [data-process-marker] { opacity: .3; transition: opacity .3s; } [data-process-marker].active { opacity: 1; color: var(--red-highlight); }
</style>
