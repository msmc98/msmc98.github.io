---
import monogram from '../../public/images/brand/monogram.svg?raw';
---
<span class="brand-symbol" aria-hidden="true" set:html={monogram} />
<style>
  .brand-symbol { display:block; width:76px; height:auto; aspect-ratio:80 / 88; flex-shrink:0; transition:opacity .2s; }
  .brand-symbol :global(svg) { width:100%; height:100%; }
  :global(.brand:hover) .brand-symbol, :global(.brand:focus-visible) .brand-symbol { opacity:.8; }
  @media(max-width:1100px) { .brand-symbol { width:68px; } }
  @media(prefers-reduced-motion:reduce) { .brand-symbol { transition:none; } }
</style>
